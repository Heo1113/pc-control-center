<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the process identity module: parsers, redaction, classifier, caches and resolver run everywhere (fakes);
       the native tests run on Windows only and skip elsewhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iron.ProcessIdentity.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Iron.ProcessIdentity\Iron.ProcessIdentity.csproj" />
  </ItemGroup>
</Project>
