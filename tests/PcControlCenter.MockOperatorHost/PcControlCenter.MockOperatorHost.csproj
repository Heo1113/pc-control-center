<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only Operator host: the same host loop as PcControlCenter.OperatorHost.exe, with E's simulated desktop only,
       so the process supervisor (start, restart, emergency stop, kill) is tested on Linux too. Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PcControlCenter.MockOperatorHost</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PcControlCenter.Operator\PcControlCenter.Operator.csproj" />
  </ItemGroup>
</Project>
