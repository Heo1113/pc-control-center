<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Product>PC Control Center</Product>
    <Authors>PC Control Center contributors</Authors>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Builds the Windows-only projects (WPF, FlaUI) on non-Windows machines too (compile only). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Same as project E: NuGet package pruning fails during restore of the FlaUI RID graphs on SDK 10.0.4xx.
         Pruning is only an optimization; every package version stays pinned in Directory.Packages.props. -->
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>
</Project>
