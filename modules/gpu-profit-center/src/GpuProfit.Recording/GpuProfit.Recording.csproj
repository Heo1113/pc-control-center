<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GpuProfit.Recording</RootNamespace>
    <!-- Project A's NVML binding uses unmanaged function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GpuProfit.Storage\GpuProfit.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Hardware sensors reused read-only from project A (NVML GPU, Windows CPU/RAM, mock providers). -->
    <Compile Include="$(VendorA)LocalAiPerf.Telemetry/**/*.cs" Link="Vendor/A/Telemetry/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GpuProfit.Tests" />
  </ItemGroup>
</Project>
