<UserControl x:Class="GpuProfit.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GpuProfit.App.Controls">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top">
      <TextBlock Text="세션" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusLine}" VerticalAlignment="Center" />
    </DockPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left: work items, start, manual entry -->
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="작업" Style="{StaticResource SectionTitle}" />
              <ListBox ItemsSource="{Binding Workloads}" SelectedItem="{Binding SelectedWorkload}" MaxHeight="180" AutomationProperties.Name="작업 목록">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text=" (보관됨)" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding Archived, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="선택한 작업 보관/해제" Command="{Binding ToggleArchiveCommand}" Style="{StaticResource ToolButton}" Margin="0,6,0,6" HorizontalAlignment="Left" />
              <TextBlock Text="새 작업 이름" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding NewWorkloadName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="새 작업 이름" />
              <TextBlock Text="유형" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding NewWorkloadType}" AutomationProperties.Name="작업 유형" />
              <TextBlock Text="메모" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding NewWorkloadNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="작업 메모" />
              <Button Content="작업 추가" Command="{Binding AddWorkloadCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="기록 시작 (선택한 작업)" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="세션 제목" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding StartTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="세션 제목" />
              <TextBlock Text="메모" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding StartNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="세션 메모" />
              <TextBlock Text="대상 GPU 번호 (예: 0 또는 0,1 · 비우면 모든 GPU)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding StartGpus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="대상 GPU" />
              <Button Content="기록 시작" Command="{Binding StartCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
              <TextBlock Text="{Binding ExecutionNote}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="지난 세션 직접 입력" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="제목" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding ManualTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="직접 입력 제목" />
              <TextBlock Text="시작 (yyyy-MM-dd HH:mm)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding ManualStart, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="직접 입력 시작" />
              <TextBlock Text="종료 (yyyy-MM-dd HH:mm)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding ManualEnd, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="직접 입력 종료" />
              <TextBlock Text="외부 전력계 PC 전체 에너지 (kWh, 선택)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding ManualWallKwh, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AutomationProperties.Name="전력계 kWh" />
              <Button Content="직접 입력 세션 만들기" Command="{Binding CreateManualCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Right: search, list, actions, detail -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="2*" MinHeight="160" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="3*" MinHeight="240" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="6,6,6,0">
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" Margin="0,0,6,6" AutomationProperties.Name="검색어">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <ComboBox ItemsSource="{Binding WorkloadFilters}" SelectedItem="{Binding FilterWorkload}" MinWidth="150" Margin="0,0,6,6" AutomationProperties.Name="작업 필터" />
          <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding FilterType}" MinWidth="150" Margin="0,0,6,6" AutomationProperties.Name="유형 필터" />
          <ComboBox ItemsSource="{Binding StateFilters}" SelectedItem="{Binding FilterState}" MinWidth="130" Margin="0,0,6,6" AutomationProperties.Name="상태 필터" />
          <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding FilterRange}" MinWidth="120" Margin="0,0,6,6" AutomationProperties.Name="기간 필터" />
          <Button Content="검색" Command="{Binding SearchCommand}" Style="{StaticResource ToolButton}" />
        </WrapPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
          <Grid>
            <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" AutomationProperties.Name="세션 목록">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" />
                <DataGridTextColumn Header="세션" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="작업" Binding="{Binding Workload}" />
                <DataGridTextColumn Header="유형" Binding="{Binding Type}" />
                <DataGridTextColumn Header="상태" Binding="{Binding State}" />
                <DataGridTextColumn Header="시작" Binding="{Binding Started}" />
                <DataGridTextColumn Header="시간" Binding="{Binding Hours}" />
                <DataGridTextColumn Header="에너지" Binding="{Binding Energy}" />
                <DataGridTextColumn Header="실현 순수익" Binding="{Binding RealizedNet}" />
                <DataGridTextColumn Header="표시" Binding="{Binding Flags}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                       Visibility="{Binding EmptyText, Converter={StaticResource NotEmptyToVisibility}}" IsHitTestVisible="False" />
          </Grid>
        </Border>
        <WrapPanel Grid.Row="2" Margin="6,0,6,0">
          <Button Content="일시정지" Command="{Binding PauseCommand}" Style="{StaticResource ToolButton}" />
          <Button Content="재개" Command="{Binding ResumeCommand}" Style="{StaticResource ToolButton}" />
          <Button Content="종료" Command="{Binding StopCommand}" Style="{StaticResource ToolButton}" />
          <Button Content="중단 (실패·취소)" Command="{Binding AbortCommand}" Style="{StaticResource ToolButton}" />
          <Button Content="수익성 보기" Command="{Binding OpenAccountingCommand}" Style="{StaticResource ToolButton}" />
          <Button Content="에너지·샘플 CSV" Command="{Binding ExportEnergyCommand}" Style="{StaticResource ToolButton}" />
          <Button Content="삭제" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}" />
        </WrapPanel>
        <Border Grid.Row="3" Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding DetailTitle}" Style="{StaticResource SectionTitle}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Evidence}" Style="{StaticResource Caption}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding EnergyNotes}" Style="{StaticResource WarningText}" Visibility="{Binding EnergyNotes, Converter={StaticResource NotEmptyToVisibility}}" />
            <TabControl Margin="0,6,0,0">
              <TabItem Header="요약">
                <DataGrid ItemsSource="{Binding Summary}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="항목" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="값" Binding="{Binding Value}" ElementStyle="{StaticResource WrapCell}" Width="2*" />
                    <DataGridTextColumn Header="근거" Binding="{Binding Note}" ElementStyle="{StaticResource WrapCell}" Width="3*" />
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>
              <TabItem Header="에너지 구성">
                <DataGrid ItemsSource="{Binding EnergyComponents}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="구성" Binding="{Binding Item}" />
                    <DataGridTextColumn Header="에너지" Binding="{Binding Value}" />
                    <DataGridTextColumn Header="출처" Binding="{Binding Origin}" />
                    <DataGridTextColumn Header="계산 근거" Binding="{Binding Basis}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>
              <TabItem Header="GPU별 에너지">
                <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="GPU" Binding="{Binding Gpu}" />
                    <DataGridTextColumn Header="실측 에너지" Binding="{Binding Measured}" />
                    <DataGridTextColumn Header="관측 시간" Binding="{Binding Observed}" />
                    <DataGridTextColumn Header="관측률" Binding="{Binding Coverage}" />
                    <DataGridTextColumn Header="평균 전력" Binding="{Binding AveragePower}" />
                    <DataGridTextColumn Header="최소/최대" Binding="{Binding MinMax}" />
                    <DataGridTextColumn Header="중앙값/P95" Binding="{Binding MedianP95}" />
                    <DataGridTextColumn Header="유효/전체 샘플" Binding="{Binding Samples}" />
                    <DataGridTextColumn Header="NVML 카운터" Binding="{Binding Counter}" />
                    <DataGridTextColumn Header="최장 공백" Binding="{Binding LongestGap}" />
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>
              <TabItem Header="구간·공백">
                <StackPanel>
                  <DataGrid ItemsSource="{Binding Segments}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="160">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="구간 시작" Binding="{Binding Start}" />
                      <DataGridTextColumn Header="구간 끝" Binding="{Binding End}" />
                      <DataGridTextColumn Header="길이" Binding="{Binding Duration}" />
                      <DataGridTextColumn Header="끝난 이유" Binding="{Binding EndReason}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <DataGrid ItemsSource="{Binding Gaps}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="220" Margin="0,8,0,0">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="공백 시작" Binding="{Binding From}" />
                      <DataGridTextColumn Header="공백 끝" Binding="{Binding To}" />
                      <DataGridTextColumn Header="길이" Binding="{Binding Duration}" />
                      <DataGridTextColumn Header="종류" Binding="{Binding Kind}" />
                      <DataGridTextColumn Header="설명" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </TabItem>
              <TabItem Header="전력 그래프">
                <c:ChartView Data="{Binding PowerChart}" MinHeight="220" />
              </TabItem>
              <TabItem Header="세션 설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="제목" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                      <TextBlock Text="메모" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                      <CheckBox Content="작업 실행 확인 (이 구간에 작업이 실제로 실행됨)" IsChecked="{Binding EditConfirmed}" Margin="0,8,0,0" />
                      <CheckBox Content="수익 없음 확인 (비용만 발생한 세션)" IsChecked="{Binding EditNoRevenue}" Margin="0,4,0,0" />
                      <TextBlock Text="대상 GPU 번호 (비우면 모든 GPU)" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding EditGpus, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                      <TextBlock Text="사용자 입력 작업 시간 (시간, 선택 · 시간당 값에 사용)" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding EditWorkHours, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="전력 산정 기준" Style="{StaticResource FieldLabel}" />
                      <ComboBox ItemsSource="{Binding Bases}" SelectedItem="{Binding EditBasis}" />
                      <TextBlock Text="미관측 구간 처리" Style="{StaticResource FieldLabel}" />
                      <ComboBox ItemsSource="{Binding Policies}" SelectedItem="{Binding EditPolicy}" />
                      <TextBlock Text="시스템 추가 전력 가정 (W, 비우면 기본값)" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding EditExtraW, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                      <TextBlock Text="GPU 유휴 전력 가정 (W, 증분 기준에 사용)" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding EditIdleW, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                      <TextBlock Text="외부 전력계 PC 전체 에너지 (kWh)" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding EditWallKwh, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                      <TextBlock Text="이 세션 전용 전기요금 (원/kWh, 비우면 기본값)" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding EditRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                      <Button Content="세션 설정 저장 및 재계산" Command="{Binding SaveDetailsCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                  </Grid>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
