<UserControl x:Class="GpuProfit.App.Views.ScenariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GpuProfit.App.Controls">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top">
      <TextBlock Text="시나리오" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusLine}" VerticalAlignment="Center" />
    </DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Background="{StaticResource InfoBannerBrush}">
      <StackPanel>
        <TextBlock Text="{Binding Note}" Style="{StaticResource Value}" />
        <TextBlock Text="{Binding TrackingText}" Style="{StaticResource WarningText}" Visibility="{Binding TrackingText, Converter={StaticResource NotEmptyToVisibility}}" />
      </StackPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="저장된 시나리오" Style="{StaticResource SectionTitle}" />
              <ListBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" DisplayMemberPath="Name" MaxHeight="180" AutomationProperties.Name="시나리오 목록" />
              <WrapPanel Margin="0,6,0,0">
                <Button Content="새로" Command="{Binding NewCommand}" Style="{StaticResource ToolButton}" />
                <Button Content="저장" Command="{Binding SaveCommand}" Style="{StaticResource ToolButton}" />
                <Button Content="낙관·비관 만들기" Command="{Binding VariantsCommand}" Style="{StaticResource ToolButton}" />
                <Button Content="삭제" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}" />
              </WrapPanel>
              <TextBlock Text="기록된 세션에서 조건 가져오기" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding SessionOptions}" SelectedItem="{Binding SourceSession}" AutomationProperties.Name="원본 세션" />
              <Button Content="세션에서 가져오기" Command="{Binding FromSessionCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="조건 (가정)" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="이름" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
              <TextBlock Text="종류" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" />
              <TextBlock Text="작업 수익 단가 (원/가동 시간, 수수료 전)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding RevenuePerHour, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
              <TextBlock Text="GPU 소비전력 (W)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding GpuPower, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
              <TextBlock Text="시스템 추가 전력 (W)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding SystemPower, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
              <TextBlock Text="전기요금 (원/kWh)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
              <TextBlock Text="GPU 가동률 (%)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Utilization, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
              <TextBlock Text="하루 작업 시간 (시간)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding HoursPerDay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
              <TextBlock Text="기간 (일)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
              <TextBlock Text="플랫폼 수수료 (%)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Fee, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
              <TextBlock Text="월 고정비 (원)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding FixedPerMonth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
              <TextBlock Text="장비 비용 / 잔존가치 (원) / 감가상각 기간 (개월)" Style="{StaticResource FieldLabel}" />
              <UniformGrid Columns="3">
                <TextBox Text="{Binding EquipmentCost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,4" AutomationProperties.Name="장비 비용" />
                <TextBox Text="{Binding Salvage, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,4" AutomationProperties.Name="잔존가치" />
                <TextBox Text="{Binding LifeMonths, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" AutomationProperties.Name="감가상각 기간" />
              </UniformGrid>
              <TextBlock Text="메모" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
              <Button Content="계산" Command="{Binding CalculateCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="결과 (조건부 계산)" Style="{StaticResource SectionTitle}" />
                <DataGrid ItemsSource="{Binding Result}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="항목" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="값" Binding="{Binding Value}" />
                    <DataGridTextColumn Header="계산" Binding="{Binding Note}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="민감도: 한 조건만 바꿨을 때 순수익" Style="{StaticResource SectionTitle}" />
                <WrapPanel DockPanel.Dock="Top">
                  <ComboBox ItemsSource="{Binding Variables}" SelectedItem="{Binding SelectedVariable}" MinWidth="200" Margin="0,0,6,6" AutomationProperties.Name="바꿀 조건" />
                  <TextBlock Text="범위" Style="{StaticResource Label}" VerticalAlignment="Center" />
                  <TextBox Text="{Binding RangeLow, UpdateSourceTrigger=PropertyChanged}" MinWidth="70" Margin="0,0,4,6" AutomationProperties.Name="범위 최소" />
                  <TextBox Text="{Binding RangeHigh, UpdateSourceTrigger=PropertyChanged}" MinWidth="70" Margin="0,0,6,6" AutomationProperties.Name="범위 최대" />
                  <Button Content="다시 그리기" Command="{Binding CalculateCommand}" Style="{StaticResource ToolButton}" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding BreakevenText}" Style="{StaticResource Value}" FontWeight="SemiBold" />
                <c:ChartView Data="{Binding SensitivityChart}" MinHeight="300" />
              </DockPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <WrapPanel>
                <TextBlock Text="조건별 영향 (각 조건 ±" Style="{StaticResource SectionTitle}" />
                <TextBox Text="{Binding TornadoPercent, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,4,8" AutomationProperties.Name="변화 비율" />
                <TextBlock Text="%, 영향이 큰 순)" Style="{StaticResource SectionTitle}" />
              </WrapPanel>
              <DataGrid ItemsSource="{Binding Tornado}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="조건" Binding="{Binding Variable}" />
                  <DataGridTextColumn Header="낮을 때" Binding="{Binding Low}" />
                  <DataGridTextColumn Header="순수익" Binding="{Binding NetAtLow}" />
                  <DataGridTextColumn Header="높을 때" Binding="{Binding High}" />
                  <DataGridTextColumn Header="순수익" Binding="{Binding NetAtHigh}" />
                  <DataGridTextColumn Header="변동 폭" Binding="{Binding Swing}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="시나리오별 비교" Style="{StaticResource SectionTitle}" />
              <DataGrid ItemsSource="{Binding Comparison}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="시나리오" Binding="{Binding Scenario}" />
                  <DataGridTextColumn Header="종류" Binding="{Binding Kind}" />
                  <DataGridTextColumn Header="가동 시간" Binding="{Binding Hours}" />
                  <DataGridTextColumn Header="에너지" Binding="{Binding Energy}" />
                  <DataGridTextColumn Header="매출" Binding="{Binding Revenue}" />
                  <DataGridTextColumn Header="전력비" Binding="{Binding Electricity}" />
                  <DataGridTextColumn Header="총비용" Binding="{Binding TotalCost}" />
                  <DataGridTextColumn Header="순수익" Binding="{Binding Net}" />
                  <DataGridTextColumn Header="시간당" Binding="{Binding NetPerHour}" />
                  <DataGridTextColumn Header="손익분기 단가" Binding="{Binding BreakevenRate}" />
                  <DataGridTextColumn Header="회수 기간" Binding="{Binding Payback}" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
