<Window x:Class="GpuProfit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GpuProfit.Presentation.ViewModels;assembly=GpuProfit.Presentation"
        xmlns:views="clr-namespace:GpuProfit.App.Views"
        Title="{Binding AppTitle}" Width="1500" Height="940" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><views:HardwareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SessionsViewModel}"><views:SessionsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProfitabilityViewModel}"><views:ProfitabilityView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CompareViewModel}"><views:CompareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ScenariosViewModel}"><views:ScenariosView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
  </Window.Resources>

  <DockPanel x:Name="Root">
    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding SensorOk, Converter={StaticResource OkBrush}}" />
          <TextBlock Text="{Binding SensorText}" Style="{StaticResource Value}" MaxWidth="460" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,18,0" />
          <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{StaticResource AccentBrush}" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding RecordingText}" Style="{StaticResource Value}" MaxWidth="520" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding DatabaseText}" Style="{StaticResource Label}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Navigation -->
    <Border DockPanel.Dock="Left" Width="200" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,18,12,16">
          <TextBlock Text="GPU Profit &amp;" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="Compute Center" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="16,8,12,14" Style="{StaticResource Caption}"
                   Text="경제성 분석 도구입니다. 채굴·작업 실행, 오버클럭, 거래를 하지 않으며 외부 서비스에 접속하지 않습니다." />
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="화면 선택">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="6,8">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="26" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Banners: mock sensors, demo data, notices -->
    <StackPanel DockPanel.Dock="Top">
      <Border Background="{StaticResource MockBannerBrush}" Padding="14,8" Visibility="{Binding IsMock, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="⚠ MOCK 센서 - 테스트용 가상 센서 값입니다. 실제 하드웨어 측정이 아닙니다 (--mock-sensors로 실행됨)." />
      </Border>
      <Border Background="{StaticResource MockBannerBrush}" Padding="14,8" Visibility="{Binding HasDemoData, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="⚠ 이 데이터베이스에 [데모] MOCK 세션이 있습니다. MOCK으로 표시된 세션은 실제 측정·수익이 아닙니다." />
      </Border>
      <ItemsControl ItemsSource="{Binding Notices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource InfoBannerBrush}" BorderBrush="{StaticResource InfoBannerBorderBrush}" BorderThickness="0,0,0,1" Padding="14,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="닫기" Padding="8,1"
                        Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                <TextBlock Text="{Binding StringFormat='ⓘ {0}'}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ContentControl Content="{Binding CurrentPage}" Margin="12,12,12,6" Focusable="False" />
  </DockPanel>
</Window>
