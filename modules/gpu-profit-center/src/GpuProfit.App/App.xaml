<Application x:Class="GpuProfit.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GpuProfit.App"
             ThemeMode="Dark"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:OkBrushConverter x:Key="OkBrush" />
      <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <local:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
      <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
