<UserControl x:Class="LocalAiPerf.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalAiPerf.App">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Width" Value="210" />
    </Style>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="LastChildFill" Value="False" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
      <TextBlock Text="설정" Style="{StaticResource PageTitle}" />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="데이터 수집" Style="{StaticResource SectionTitle}" />
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="기록 간격 (ms)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding IntervalMs}" Width="120" />
            <TextBlock Text="500 ~ 60000. 바꾸면 진행 중인 세션은 닫히고 새 세션으로 이어집니다." Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <CheckBox Content="GPU 센서 사용 (NVIDIA NVML, 관리자 권한 불필요)" IsChecked="{Binding GpuEnabled}" Margin="0,4" />
          <CheckBox Content="CPU·RAM 센서 사용 (Windows API, 관리자 권한 불필요)" IsChecked="{Binding SystemEnabled}" Margin="0,4" />
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="표시할 GPU 번호" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding GpuIndex}" Width="60" />
            <TextBlock Text="모든 GPU는 기록되며, 화면과 분석에 쓸 GPU를 고릅니다." Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="기록과 보존" Style="{StaticResource SectionTitle}" />
          <CheckBox Content="앱이 시작되면 자동으로 기록 (자동 세션)" IsChecked="{Binding AutoRecord}" Margin="0,4" />
          <CheckBox Content="엔진 버전·모델·컨텍스트·설정이 바뀌면 자동 세션을 나눔 (업데이트 전후 비교용)" IsChecked="{Binding AutoSplit}" Margin="0,4" />
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="보존 기간 (일)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding RetentionDays}" Width="120" />
            <TextBlock Text="1 ~ 3650. 지난 데이터는 1시간마다 삭제됩니다." Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="저장 공간 상한 (MB)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding MaxDatabaseSizeMb}" Width="120" />
            <TextBlock Text="64 ~ 102400. 넘으면 가장 오래된 세션부터 삭제합니다 (기록 중인 세션은 오래된 샘플만)." Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="프롬프트 원문, 모델 응답, 인증 정보는 저장하지 않습니다." Style="{StaticResource Caption}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Strata 연결 (읽기 전용)" Style="{StaticResource SectionTitle}" />
          <CheckBox Content="Strata 연결 사용" IsChecked="{Binding StrataEnabled}" Margin="0,4" />
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="서버 주소" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding StrataUrl}" Width="300" />
            <TextBlock Text="기본 http://127.0.0.1:8080. 원격은 https만 허용." Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <CheckBox Content="포트 자동 찾기 (응답이 없으면 데스크톱 앱 엔진 포트 127.0.0.1:18500~18520에서 /health로 Strata를 찾음)" IsChecked="{Binding StrataAutoFindPort}" Margin="0,4" />
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="API 키 환경 변수 이름" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding KeyVariable, UpdateSourceTrigger=PropertyChanged}" Width="300" />
          </DockPanel>
          <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Caption}" Margin="210,0,0,4" />
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="응답 제한 시간 (ms)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding TimeoutMs}" Width="120" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="모델 정보 갱신 주기 (초)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding MetadataRefreshSeconds}" Width="120" />
          </DockPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                     Text="GET /v1/telemetry, /health, /v1/status, /props, /v1/models (구버전은 /metrics)만 읽습니다. /status는 답변 일부를 포함할 수 있어 호출하지 않습니다. Strata 설치·설정·업데이트에는 관여하지 않습니다." />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="분석" Style="{StaticResource SectionTitle}" />
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="성능 저하 임계값 (%)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding DegradationThreshold}" Width="120" />
            <TextBlock Text="기준 구간 중앙값보다 이 비율 이상 낮으면 후보" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="최소 지속 시간 (초)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding MinDegradationSeconds}" Width="120" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="기준 구간 길이 (초)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding BaselineWindowSeconds}" Width="120" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="GPU 고온 기준 (°C)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding HighGpuTemp}" Width="120" />
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="실시간 그래프 길이 (분)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding LiveChartMinutes}" Width="120" />
          </DockPanel>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="6">
        <Button Content="저장하고 적용" Command="{Binding SaveCommand}" Padding="16,4" Margin="0,0,8,0" />
        <Button Content="되돌리기" Command="{Binding RevertCommand}" Padding="12,4" Margin="0,0,8,0" />
        <Button Content="기본값" Command="{Binding ResetDefaultsCommand}" Padding="12,4" />
        <TextBlock Text="처리 중…" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Messages}" Margin="8,0,8,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}" /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="데이터 관리" Style="{StaticResource SectionTitle}" />
          <DockPanel Style="{StaticResource Row}">
            <TextBlock Text="데이터 폴더" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource Value}" VerticalAlignment="Center" MaxWidth="620" />
          </DockPanel>
          <DataGrid ItemsSource="{Binding DatabaseInfo}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="항목" Binding="{Binding Name, Mode=OneWay}" Width="90" />
              <DataGridTemplateColumn Header="값" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Value}" Style="{StaticResource WrapCell}" /></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="폴더 열기" Command="{Binding OpenDataFolderCommand}" Margin="0,0,6,6" Padding="10,3" />
            <Button Content="정보 새로 고침" Command="{Binding RefreshDatabaseCommand}" Margin="0,0,6,6" Padding="10,3" />
            <Button Content="백업 만들기" Command="{Binding BackupCommand}" Margin="0,0,6,6" Padding="10,3" />
            <Button Content="백업에서 복원" Command="{Binding RestoreCommand}" Margin="0,0,6,6" Padding="10,3" />
            <Button Content="무결성 검사" Command="{Binding IntegrityCheckCommand}" Margin="0,0,6,6" Padding="10,3" />
            <Button Content="보존 정책 지금 적용" Command="{Binding ApplyRetentionCommand}" Margin="0,0,6,6" Padding="10,3" />
            <Button Content="진단 정보 내보내기" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,6,6" Padding="10,3" />
          </WrapPanel>
          <TextBlock Style="{StaticResource Caption}"
                     Text="복원은 현재 DB를 지우지 않고 옆에 보관합니다. 손상된 DB는 시작할 때 자동으로 옆에 보관하고 새 DB를 만듭니다. 진단 정보에는 API 키 값·프롬프트·응답이 들어가지 않습니다." />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Visibility="{Binding Notices.Count, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
        <StackPanel>
          <TextBlock Text="시작 알림" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding Notices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,2" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="정보" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}"
                     Text="Local AI Performance Center - 로컬 AI 추론 환경의 하드웨어·추론 성능 관측 도구. 일반 사용자 권한으로 동작하며 외부 네트워크에 접속하지 않습니다 (설정한 Strata 주소 제외). 사용한 오픈소스의 라이선스는 실행 파일 옆 THIRD-PARTY-NOTICES.md에 있습니다." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
