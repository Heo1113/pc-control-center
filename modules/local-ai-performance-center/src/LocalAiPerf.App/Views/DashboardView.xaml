<UserControl x:Class="LocalAiPerf.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LocalAiPerf.App.Controls"
             xmlns:local="clr-namespace:LocalAiPerf.App">
  <UserControl.Resources>
    <local:StatusBrushConverter x:Key="StatusBrush" />
    <local:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel>
        <TextBlock Text="대시보드" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding MeasuredAt, StringFormat='측정 시각 {0}'}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="6,0,6,12" />
      </DockPanel>

      <UniformGrid Columns="3">
        <!-- GPU -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding GpuName}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding GpuUtil}" Style="{StaticResource BigValue}" ToolTip="GPU 사용률 (NVML 실측)" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="온도" Style="{StaticResource Label}" />
              <TextBlock Grid.Column="1" Text="{Binding GpuTemp}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="1" Text="전력 / 제한" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuPower}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="2" Text="VRAM" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}">
                <Run Text="{Binding GpuVram, Mode=OneWay}" /> <Run Text="{Binding GpuVramPercent, Mode=OneWay, StringFormat='({0})'}" Foreground="{StaticResource TextMutedBrush}" />
              </TextBlock>
              <TextBlock Grid.Row="3" Text="그래픽 클럭" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GpuClock}" Style="{StaticResource Value}" />
            </Grid>
            <TextBlock Text="{Binding ThrottleText}" Style="{StaticResource Caption}" Foreground="{Binding ThrottleLevel, Converter={StaticResource StatusBrush}}"
                       Visibility="{Binding ThrottleText, Converter={StaticResource NotEmpty}}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding GpuNote}" Style="{StaticResource Caption}" Visibility="{Binding GpuNote, Converter={StaticResource NotEmpty}}" Margin="0,6,0,0" />
            <TextBlock Text="출처: NVIDIA NVML (실측)" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- CPU / RAM -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="CPU · 시스템 메모리" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{Binding CpuUtil}" Style="{StaticResource BigValue}" ToolTip="전체 논리 프로세서 평균 CPU 사용률" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="RAM 사용 / 전체" Style="{StaticResource Label}" />
              <TextBlock Grid.Column="1" Text="{Binding RamUsed}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="1" Text="RAM 사용 비율" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RamPercent}" Style="{StaticResource Value}" />
            </Grid>
            <TextBlock Text="출처: Windows API (실측) · CPU 온도는 관리자 권한/드라이버가 필요해 수집하지 않음" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- AI runtime -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="{Binding RuntimeName}" Style="{StaticResource CardTitle}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding RuntimeLevel, Converter={StaticResource StatusBrush}}" />
                <TextBlock Text="{Binding RuntimeState}" Style="{StaticResource Value}" />
              </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding AnswerTokS}" Style="{StaticResource BigValue}" ToolTip="답변 생성 속도: 생성 중이면 Strata 보고값, 아니면 마지막 완료 요청의 디코드 속도(계산값)" />
            <TextBlock Text="{Binding AnswerBasis}" Style="{StaticResource Caption}" Margin="0,-4,0,6" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="모델" Style="{StaticResource Label}" />
              <TextBlock Grid.Column="1" Text="{Binding RuntimeModel}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="1" Text="엔진 버전" Style="{StaticResource Label}" Visibility="{Binding RuntimeEngine, Converter={StaticResource NotEmpty}}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeEngine}" Style="{StaticResource Value}" Visibility="{Binding RuntimeEngine, Converter={StaticResource NotEmpty}}" />
              <TextBlock Grid.Row="2" Text="프롬프트 처리" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PrefillTokS}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="3" Text="전체 출력 (계산값)" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AggregateTokS}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="4" Text="요청" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Requests}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="5" Text="컨텍스트" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Context}" Style="{StaticResource Value}" />
            </Grid>
            <TextBlock Text="{Binding RuntimeMessage}" Style="{StaticResource Caption}" Visibility="{Binding RuntimeMessage, Converter={StaticResource NotEmpty}}" Margin="0,6,0,0" />
            <TextBlock Text="출처: Strata 공개 API (엔진 보고) · 하드웨어 표시는 Strata와 무관하게 계속됩니다" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}" Height="250"><c:ChartView Model="{Binding UtilizationChart}" /></Border>
        <Border Style="{StaticResource Card}" Height="250"><c:ChartView Model="{Binding ThroughputChart}" /></Border>
        <Border Style="{StaticResource Card}" Height="250"><c:ChartView Model="{Binding PowerChart}" /></Border>
        <Border Style="{StaticResource Card}" Height="250"><c:ChartView Model="{Binding VramChart}" /></Border>
      </UniformGrid>
      <TextBlock Style="{StaticResource Caption}" Margin="8,4"
                 Text="실측 = 이 앱이 NVML/Windows API로 직접 읽은 값 · 엔진 보고 = Strata가 공개 API로 알려준 값 · 계산값 = 이 앱이 계산한 값 · N/A = 센서나 엔진이 제공하지 않음 (추정하지 않음)" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
