<UserControl x:Class="LocalAiPerf.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LocalAiPerf.App.Controls"
             xmlns:local="clr-namespace:LocalAiPerf.App">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:HexToBrushConverter x:Key="HexToBrush" />
    <local:DirectionBrushConverter x:Key="DirectionBrush" />
    <local:DirectionTextConverter x:Key="DirectionText" />
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="400" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="비교" Style="{StaticResource PageTitle}" />
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="새로 고침" Command="{Binding RefreshCommand}" Margin="6,0,0,0" Padding="10,2" />
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="이름, 태그, 모델, 엔진 버전으로 검색 후 새로 고침" />
          </DockPanel>
          <TextBlock Text="세션을 2개 이상 체크하세요 (최대 8개). 색은 세션마다 고정됩니다." Style="{StaticResource Caption}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <ListBox ItemsSource="{Binding Sessions}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="2,4">
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Border DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                <StackPanel>
                  <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Started, Mode=OneWay}" /> · <Run Text="{Binding Duration, Mode=OneWay}" /> · <Run Text="{Binding Model, Mode=OneWay}" /> · 엔진 <Run Text="{Binding Engine, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </DockPanel>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <WrapPanel>
              <TextBlock Text="기준 세션" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Selected}" SelectedItem="{Binding Baseline}" DisplayMemberPath="Label" MinWidth="260" />
              <Button Content="비교" Command="{Binding CompareCommand}" Margin="12,0,0,0" Padding="18,3" />
              <Button Content="CSV 내보내기" Command="{Binding ExportCommand}" CommandParameter="csv" Margin="12,0,0,0" Padding="10,3"
                      IsEnabled="{Binding HasResult}" />
              <Button Content="JSON 내보내기" Command="{Binding ExportCommand}" CommandParameter="json" Margin="6,0,0,0" Padding="10,3"
                      IsEnabled="{Binding HasResult}" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
          </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="주의 사항 (조건 차이)" Style="{StaticResource SectionTitle}" />
              <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,2" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}">
                      <Run Text="⚠ 주의" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" /> <Run Text="{Binding Message, Mode=OneWay}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="지표별 비교 (평균 (최소~최대, 표본 수) · 기준 대비 변화율)" Style="{StaticResource SectionTitle}" />
              <DataGrid x:Name="RowsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="0,4,0,0" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                         Text="▲ 개선 / ▼ 저하는 지표의 좋은 방향(예: tok/s는 높을수록, 온도는 낮을수록)을 기준으로 한 계산값이며 ±1% 미만은 표시하지 않습니다. 작업 부하가 다르면 차이가 클 수 있습니다." />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="그래프 지표" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ChartMetrics}" SelectedItem="{Binding SelectedMetric}" DisplayMemberPath="DisplayName" MinWidth="240" />
              </StackPanel>
              <c:ChartView Model="{Binding Chart}" Interactive="True" Height="320" Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="세션별 성능 저하 후보 (함께 관측된 항목은 원인이 아님)" Style="{StaticResource SectionTitle}" />
              <DataGrid ItemsSource="{Binding Degradations}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="세션 · 지표" Binding="{Binding Metric, Mode=OneWay}" Width="200" />
                  <DataGridTextColumn Header="시작" Binding="{Binding Start, Mode=OneWay}" Width="150" />
                  <DataGridTextColumn Header="길이" Binding="{Binding Duration, Mode=OneWay}" Width="80" />
                  <DataGridTextColumn Header="하락" Binding="{Binding Drop, Mode=OneWay}" Width="60" />
                  <DataGridTemplateColumn Header="함께 관측됨" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Text="{Binding Observations}" Style="{StaticResource WrapCell}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
