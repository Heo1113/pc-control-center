<UserControl x:Class="LocalAiPerf.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LocalAiPerf.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel>
        <TextBlock Text="하드웨어" Style="{StaticResource PageTitle}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="그래프 구간" Style="{StaticResource Label}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding WindowMinutes}" ItemStringFormat="최근 {0}분" MinWidth="110" />
        </StackPanel>
      </DockPanel>
      <TextBlock Text="{Binding ElevationText}" Style="{StaticResource Caption}" Margin="8,0,8,6" />

      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}" Height="220"><c:ChartView Model="{Binding GpuUtilChart}" /></Border>
        <Border Style="{StaticResource Card}" Height="220"><c:ChartView Model="{Binding TempChart}" /></Border>
        <Border Style="{StaticResource Card}" Height="220"><c:ChartView Model="{Binding PowerChart}" /></Border>
        <Border Style="{StaticResource Card}" Height="220"><c:ChartView Model="{Binding VramChart}" /></Border>
        <Border Style="{StaticResource Card}" Height="220"><c:ChartView Model="{Binding ClockChart}" /></Border>
        <Border Style="{StaticResource Card}" Height="220"><c:ChartView Model="{Binding PcieChart}" /></Border>
        <Border Style="{StaticResource Card}" Height="220"><c:ChartView Model="{Binding CpuChart}" /></Border>
        <Border Style="{StaticResource Card}" Height="220"><c:ChartView Model="{Binding RamChart}" /></Border>
      </UniformGrid>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="현재 값" Style="{StaticResource SectionTitle}" />
            <DataGrid ItemsSource="{Binding CurrentValues}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="항목" Binding="{Binding Name, Mode=OneWay}" Width="170" />
                <DataGridTextColumn Header="값" Binding="{Binding Value, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="출처" Binding="{Binding Origin, Mode=OneWay}" Width="70" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="장치 정보" Style="{StaticResource SectionTitle}" />
            <DataGrid ItemsSource="{Binding DeviceInfo}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="항목" Binding="{Binding Name, Mode=OneWay}" Width="120" />
                <DataGridTemplateColumn Header="값" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Text="{Binding Value}" Style="{StaticResource WrapCell}" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
      </Grid>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="센서 지원 표 (일반 사용자 권한 / 관리자 권한 구분)" Style="{StaticResource SectionTitle}" />
          <DataGrid ItemsSource="{Binding Sensors}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="항목" Binding="{Binding Name, Mode=OneWay}" Width="190" />
              <DataGridTextColumn Header="상태" Binding="{Binding Status, Mode=OneWay}" Width="160" />
              <DataGridTextColumn Header="출처" Binding="{Binding Source, Mode=OneWay}" Width="150" />
              <DataGridCheckBoxColumn Header="관리자 권한 필요" Binding="{Binding RequiresElevation, Mode=OneWay}" Width="120" />
              <DataGridTemplateColumn Header="설명" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Detail}" Style="{StaticResource WrapCell}" /></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
