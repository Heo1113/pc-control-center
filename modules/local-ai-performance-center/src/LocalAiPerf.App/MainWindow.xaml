<Window x:Class="LocalAiPerf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalAiPerf.Presentation.ViewModels;assembly=LocalAiPerf.Presentation"
        xmlns:views="clr-namespace:LocalAiPerf.App.Views"
        xmlns:local="clr-namespace:LocalAiPerf.App"
        Title="{Binding AppTitle}" Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}">
  <Window.Resources>
    <local:StatusBrushConverter x:Key="StatusBrush" />
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><views:HardwareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:RuntimeViewModel}"><views:RuntimeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CompareViewModel}"><views:CompareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding IsRecording, Converter={StaticResource StatusBrush}}" />
          <TextBlock Text="{Binding RecordingText}" Style="{StaticResource Value}" MaxWidth="420" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <Button Content="수동 기록 시작" Command="{Binding StartRecordingCommand}" Margin="12,0,0,0" Padding="10,2" />
          <Button Content="기록 중지" Command="{Binding StopRecordingCommand}" Margin="6,0,0,0" Padding="10,2"
                  Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding Freshness, Converter={StaticResource StatusBrush}}" />
          <TextBlock Text="{Binding FreshnessText}" Style="{StaticResource Value}" Margin="0,0,18,0" />
          <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding RuntimeState, Converter={StaticResource StatusBrush}}" />
          <TextBlock Text="{Binding RuntimeStatusText}" Style="{StaticResource Value}" Margin="0,0,18,0" />
          <TextBlock Text="{Binding DatabaseText}" Style="{StaticResource Label}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Navigation -->
    <Border DockPanel.Dock="Left" Width="190" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,18,12,16">
          <TextBlock Text="Local AI" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="Performance Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="화면 선택">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="6,8">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="26" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Banners -->
    <StackPanel DockPanel.Dock="Top">
      <Border Background="{StaticResource MockBannerBrush}" Padding="14,8" Visibility="{Binding IsMock, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="⚠ MOCK 데이터 - 테스트용 가상 센서 값입니다. 실제 하드웨어 측정이 아닙니다 (--mock-sensors로 실행됨)." />
      </Border>
      <ItemsControl ItemsSource="{Binding Notices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#1f2733" BorderBrush="#2f3d52" BorderThickness="0,0,0,1" Padding="14,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="닫기" Padding="8,1"
                        Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                <TextBlock Text="{Binding StringFormat='ⓘ {0}'}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ContentControl Content="{Binding CurrentPage}" Margin="12,12,12,6" Focusable="False" />
  </DockPanel>
</Window>
