<!-- PC Control Center: everything this module's views expect from their old App.xaml and MainWindow.xaml
     (theme, converters, view-model to view templates), merged into the shell's host for this module only. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:WindowsAiOperator.Presentation.ViewModels;assembly=WindowsAiOperator.Presentation"
                    xmlns:views="clr-namespace:WindowsAiOperator.App.Views"
                    xmlns:local="clr-namespace:WindowsAiOperator.App">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/Theme.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <local:ToneBrushConverter x:Key="ToneBrush" />
  <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <local:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
  <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
  <local:NotEmptyToVisibilityConverter x:Key="EmptyToVisibility" Invert="True" />
  <local:PngToImageConverter x:Key="PngToImage" />
  <local:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
  <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:TaskRunnerViewModel}"><views:TaskRunnerView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:InspectorViewModel}"><views:InspectorView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:WorkflowLibraryViewModel}"><views:WorkflowLibraryView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:ModelsViewModel}"><views:ModelsView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:SafetySettingsViewModel}"><views:SafetySettingsView /></DataTemplate>
  <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
</ResourceDictionary>
