<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinDiag.Collection</RootNamespace>
    <!-- Project A's NVML binding uses unmanaged function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinDiag.Core\WinDiag.Core.csproj" />
    <ProjectReference Include="..\WinDiag.Storage\WinDiag.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WinDiag.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- PC Control Center: was compiled from B/C's vendor copy of project A; now references A's single copy
         (modules/local-ai-performance-center), so the sensor code exists once in the integrated app. -->
    <ProjectReference Include="..\..\..\local-ai-performance-center\src\LocalAiPerf.Telemetry\LocalAiPerf.Telemetry.csproj" />
  </ItemGroup>
</Project>
