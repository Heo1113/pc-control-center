<Window x:Class="PcControlCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:PcControlCenter.Presentation;assembly=PcControlCenter.Presentation"
        xmlns:views="clr-namespace:PcControlCenter.App.Views"
        xmlns:hosting="clr-namespace:PcControlCenter.App.Hosting"
        xmlns:avm="clr-namespace:LocalAiPerf.Presentation.ViewModels;assembly=LocalAiPerf.Presentation"
        xmlns:bvm="clr-namespace:GpuProfit.Presentation.ViewModels;assembly=GpuProfit.Presentation"
        xmlns:cvm="clr-namespace:WinDiag.Presentation.ViewModels;assembly=WinDiag.Presentation"
        Title="{Binding AppTitle}" Width="1560" Height="960" MinWidth="1024" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        AutomationProperties.AutomationId="PcControlCenterMainWindow">
  <Window.Resources>
    <!-- Shell pages -->
    <DataTemplate DataType="{x:Type p:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type p:SharedSensorsViewModel}"><views:SharedSensorsView /></DataTemplate>
    <DataTemplate DataType="{x:Type p:ShellSettingsViewModel}"><views:ShellSettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type p:HistoryViewModel}"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type p:DataMigrationViewModel}"><views:DataMigrationView /></DataTemplate>
    <DataTemplate DataType="{x:Type p:ModuleUnavailableViewModel}"><views:ModuleUnavailableView /></DataTemplate>
    <DataTemplate DataType="{x:Type p:PendingPageViewModel}">
      <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MaxWidth="760">
        <TextBlock Text="{Binding Message}" Style="{StaticResource Value}" />
      </Border>
    </DataTemplate>

    <!-- Module status strips: what each program showed in its own status bar and banners (resources come from the
         module's ModuleResources.xaml through the page host). -->
    <DataTemplate DataType="{x:Type avm:MainViewModel}">
      <StackPanel Margin="0,0,0,6">
        <Border Background="{StaticResource SectionBarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
          <WrapPanel VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding IsRecording, Converter={StaticResource LocalAiStatusBrush}}" />
            <TextBlock Text="{Binding RecordingText}" Style="{StaticResource Value}" MaxWidth="420" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
            <Button Content="수동 기록 시작" Command="{Binding StartRecordingCommand}" Margin="10,0,0,0" Padding="10,2" AutomationProperties.AutomationId="LocalAiStartRecording" />
            <Button Content="기록 중지" Command="{Binding StopRecordingCommand}" Margin="6,0,18,0" Padding="10,2"
                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
            <Ellipse Width="10" Height="10" Margin="12,0,6,0" VerticalAlignment="Center" Fill="{Binding Freshness, Converter={StaticResource LocalAiStatusBrush}}" />
            <TextBlock Text="{Binding FreshnessText}" Style="{StaticResource Value}" Margin="0,0,18,0" VerticalAlignment="Center" />
            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding RuntimeState, Converter={StaticResource LocalAiStatusBrush}}" />
            <TextBlock Text="{Binding RuntimeStatusText}" Style="{StaticResource Value}" Margin="0,0,18,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DatabaseText}" Style="{StaticResource Label}" VerticalAlignment="Center" />
          </WrapPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Notices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource InfoBannerBrush}" BorderBrush="{StaticResource InfoBannerBorderBrush}" BorderThickness="0,0,0,1" Padding="12,5" Margin="0,4,0,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="닫기" Padding="8,1"
                          Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding StringFormat='ⓘ {0}'}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type bvm:MainViewModel}">
      <StackPanel Margin="0,0,0,6">
        <Border Background="{StaticResource SectionBarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
          <WrapPanel VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding SensorOk, Converter={StaticResource EconomicsOkBrush}}" />
            <TextBlock Text="{Binding SensorText}" Style="{StaticResource Value}" MaxWidth="460" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding RecordingText}" Style="{StaticResource Value}" MaxWidth="520" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DatabaseText}" Style="{StaticResource Label}" VerticalAlignment="Center" />
          </WrapPanel>
        </Border>
        <Border Background="{StaticResource MockBannerBrush}" Padding="12,6" Margin="0,4,0,0" Visibility="{Binding HasDemoData, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                     Text="⚠ 이 데이터베이스에 [데모] MOCK 세션이 있습니다. MOCK으로 표시된 세션은 실제 측정·수익이 아닙니다." />
        </Border>
        <ItemsControl ItemsSource="{Binding Notices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource InfoBannerBrush}" BorderBrush="{StaticResource InfoBannerBorderBrush}" BorderThickness="0,0,0,1" Padding="12,5" Margin="0,4,0,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="닫기" Padding="8,1"
                          Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding StringFormat='ⓘ {0}'}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type cvm:MainViewModel}">
      <StackPanel Margin="0,0,0,6">
        <Border Background="{StaticResource SectionBarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
          <WrapPanel VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding CollectionLevel, Converter={StaticResource DiagnosticsStatusBrush}}" />
            <TextBlock Text="{Binding CollectionText}" Style="{StaticResource Value}" MaxWidth="520" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding SensorLevel, Converter={StaticResource DiagnosticsStatusBrush}}" />
            <TextBlock Text="{Binding SensorText}" Style="{StaticResource Value}" MaxWidth="420" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DatabaseText}" Style="{StaticResource Label}" VerticalAlignment="Center" />
          </WrapPanel>
        </Border>
        <Border Background="{StaticResource MockBannerBrush}" Padding="12,6" Margin="0,4,0,0" Visibility="{Binding HasVirtualData, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                     Text="⚠ 이 데이터베이스에 가상(테스트) 이벤트가 있습니다. '가상'으로 표시된 항목은 실제 PC 기록이 아닙니다." />
        </Border>
        <ItemsControl ItemsSource="{Binding Notices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource InfoBannerBrush}" BorderBrush="{StaticResource InfoBannerBorderBrush}" BorderThickness="0,0,0,1" Padding="12,5" Margin="0,4,0,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="닫기" Padding="8,1"
                          Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding StringFormat='ⓘ {0}'}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <!-- E: its status line and the always-available Operator controls (resources from E's ModuleResources.xaml). -->
    <DataTemplate DataType="{x:Type hosting:OperatorHeader}">
      <StackPanel Margin="0,0,0,6">
        <Border Background="{StaticResource MockBannerBrush}" Padding="12,6" Margin="0,0,0,4" Visibility="{Binding Main.IsMock, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                     Text="MOCK 데스크톱 모드: 실제 Windows 창을 조작하지 않는 가상 화면입니다. 여기서의 성공은 실제 GUI 자동화 성공이 아닙니다." />
        </Border>
        <Border Background="{StaticResource SectionBarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="재개" Command="{Binding Controls.ResumeCommand}" Margin="6,0,0,0" Padding="10,3"
                      Visibility="{Binding Controls.IsLatched, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="OperatorResume" />
              <Button Content="실행 프로세스 다시 시작" Command="{Binding Controls.RestartHostCommand}" Margin="6,0,0,0" Padding="10,3" />
              <Button Content="긴급 중단 (Ctrl+Alt+F12)" Command="{Binding Controls.EmergencyStopCommand}" Style="{StaticResource DangerButton}" Margin="6,0,0,0"
                      AutomationProperties.AutomationId="OperatorEmergencyStop" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Controls.HostLevel, Converter={StaticResource LevelBrush}}" />
                <TextBlock Text="{Binding Controls.HostText}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Text="{Binding Main.StatusLine}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="16,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <TextBlock Text="{Binding Controls.IsolationText}" Style="{StaticResource Caption}" Margin="4,4,4,0" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <DockPanel>
      <!-- Common status bar: the shared sensor reader and every module, whatever page is open. -->
      <Border DockPanel.Dock="Bottom" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
        <DockPanel LastChildFill="False">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding SensorStatusLevel, Converter={StaticResource LevelBrush}}" />
            <TextBlock Text="{Binding SensorStatusText}" Style="{StaticResource Value}" Margin="0,0,18,0" TextWrapping="NoWrap" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="SensorStatus" />
            <ItemsControl ItemsSource="{Binding ModuleRows}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,14,0" ToolTip="{Binding Summary}" Background="Transparent">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Level, Converter={StaticResource LevelBrush}}" />
                    <TextBlock Style="{StaticResource Value}" TextWrapping="NoWrap" VerticalAlignment="Center">
                      <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StateText, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
            <Button Content="Operator 긴급 중단" Command="{Binding Operator.EmergencyStopCommand}" Style="{StaticResource DangerButton}" Margin="0,0,14,0" Padding="10,2"
                    Visibility="{Binding HasOperator, Converter={StaticResource BoolToVisibility}}" ToolTip="Ctrl+Alt+F12 — 실행 중인 Operator 작업을 즉시 멈추고 열린 승인 요청을 거부합니다."
                    AutomationProperties.AutomationId="GlobalEmergencyStop" />
            <TextBlock Text="{Binding DataRootText}" Style="{StaticResource Label}" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ClockText}" Style="{StaticResource Label}" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Navigation: one menu for all four programs -->
      <Border DockPanel.Dock="Left" Width="212" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="16,18,12,16">
            <TextBlock Text="PC Control Center" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="로컬 AI · GPU 경제성 · 진단 · Operator" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Margin="16,8,12,14" Style="{StaticResource Caption}"
                     Text="관리자 권한 없이 동작합니다. 시스템 설정·BIOS를 바꾸지 않으며, 기존 프로그램의 데이터는 읽기만 합니다." />
          <ListBox x:Name="SectionList" ItemsSource="{Binding Sections}" SelectedItem="{Binding CurrentSection}" Background="Transparent" BorderThickness="0"
                   AutomationProperties.Name="메뉴" AutomationProperties.AutomationId="ShellNavigation">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="6,8" ToolTip="{Binding Description}">
                  <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="26" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Banners: MOCK sensors, shell notices -->
      <StackPanel DockPanel.Dock="Top">
        <Border Background="{StaticResource MockBannerBrush}" Padding="14,8" Visibility="{Binding IsMock, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                     Text="⚠ MOCK 센서 - 테스트용 가상 센서 값입니다. 실제 하드웨어 측정이 아니며, 모든 모듈의 기록에 MOCK으로 표시됩니다 (--mock-sensors)." />
        </Border>
        <ItemsControl ItemsSource="{Binding Notices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource InfoBannerBrush}" BorderBrush="{StaticResource InfoBannerBorderBrush}" BorderThickness="0,0,0,1" Padding="14,6">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="닫기" Padding="8,1"
                          Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding StringFormat='ⓘ {0}'}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentControl x:Name="GlobalBanners" Focusable="False" />
      </StackPanel>

      <!-- Section: title, its pages as tabs, the selected page -->
      <DockPanel Margin="12,10,12,6">
        <StackPanel DockPanel.Dock="Top" Margin="6,0,6,4">
          <TextBlock Text="{Binding CurrentSection.Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,2" />
          <TextBlock Text="{Binding CurrentSection.Description}" Style="{StaticResource Caption}" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,6,0,8">
          <Border DockPanel.Dock="Right" Style="{StaticResource OriginTag}"
                  Visibility="{Binding CurrentSection.SelectedTab.Origin, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock Text="{Binding CurrentSection.SelectedTab.Origin, StringFormat='출처: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
          </Border>
          <ListBox x:Name="TabList" ItemsSource="{Binding CurrentSection.Tabs}" SelectedItem="{Binding CurrentSection.SelectedTab}" Background="Transparent" BorderThickness="0"
                   AutomationProperties.Name="화면" AutomationProperties.AutomationId="ShellTabs" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Title}" FontSize="13" Margin="4,2" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <hosting:ModulePageHost x:Name="PageHost" Tab="{Binding CurrentSection.SelectedTab}" />
      </DockPanel>
    </DockPanel>
  </Grid>
</Window>
