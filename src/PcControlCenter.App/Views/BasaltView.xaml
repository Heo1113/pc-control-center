<UserControl x:Class="PcControlCenter.App.Views.BasaltView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="BasaltPage">
  <!-- Status and controls on top; below, Basalt's own dashboard (WebView2, created in code only while Basalt answers) or
       what to do. Nothing in WPF is drawn over the WebView2 window (it would be hidden behind it). -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Style="{StaticResource StatusDot}" Width="9" Height="9" Fill="{Binding StateLevel, Converter={StaticResource LevelBrush}}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StateText}" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="BasaltState" />
          </StackPanel>
          <TextBlock Text="{Binding ModeLine}" Style="{StaticResource Caption}" Margin="17,3,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="17,1,0,0" TextWrapping="Wrap"
                     Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                    ToolTip="다음에 켤 때 쓸 설정 파일. 두 모드는 같은 포트를 써서 동시에 켤 수 없습니다.">
          <RadioButton Content="품질용" IsChecked="{Binding IsQuality}" GroupName="BasaltMode" MinWidth="0" Margin="0,0,16,0" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="BasaltQuality" />
          <RadioButton Content="빠른 모드" IsChecked="{Binding IsFast}" GroupName="BasaltMode" MinWidth="0" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="BasaltFast" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="켜기" Style="{StaticResource PrimaryButton}" Padding="16,4" Command="{Binding StartCommand}" Margin="0,0,6,0"
                  AutomationProperties.AutomationId="BasaltStart" />
          <Button Content="끄기" Style="{StaticResource ToolButton}" Padding="16,4" Command="{Binding StopCommand}" Margin="0,0,6,0"
                  AutomationProperties.AutomationId="BasaltStop"
                  ToolTip="Ctrl+C로 정상 종료를 기다린 뒤, 남은 Basalt 프로세스만 정리하고 남은 것이 없는지 확인합니다." />
          <Button Content="브라우저에서 열기" Style="{StaticResource ToolButton}" Command="{Binding OpenInBrowserCommand}"
                  ToolTip="{Binding DashboardUrl}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource NotificationBrush}" BorderBrush="{StaticResource NotificationBorderBrush}" BorderThickness="1"
            CornerRadius="4" Padding="10,6" Margin="6,0,6,6" Visibility="{Binding Notice, Converter={StaticResource NotEmptyToVisibility}}">
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.AutomationId="BasaltNotice" />
    </Border>

    <Border DockPanel.Dock="Top" Margin="6,0,6,6" Visibility="{Binding ApiFields.Count, Converter={StaticResource NotEmptyToVisibility}}">
      <Expander HorizontalAlignment="Stretch" ToolTip="{Binding ApiNote}">
        <Expander.Header>
          <TextBlock Text="Basalt API 값 (Strata 호환 주소를 키 없이 읽음 · 없는 값은 미지원)" AutomationProperties.AutomationId="BasaltApi" />
        </Expander.Header>
        <StackPanel Margin="15,6,0,0">
          <ItemsControl ItemsSource="{Binding ApiFields}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="190" Margin="0,0,12,6">
                  <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                  <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding ApiNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
    </Border>

    <Border DockPanel.Dock="Top" Margin="6,0,6,6" Visibility="{Binding LastStopSummary, Converter={StaticResource NotEmptyToVisibility}}">
      <Expander HorizontalAlignment="Stretch">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <Ellipse Style="{StaticResource StatusDot}" Width="7" Height="7" Fill="{Binding LastStopLevel, Converter={StaticResource LevelBrush}}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LastStopSummary}" Margin="8,0,0,0" AutomationProperties.AutomationId="BasaltLastStop" />
          </StackPanel>
        </Expander.Header>
        <ItemsControl ItemsSource="{Binding LastStopLines}" Margin="15,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" TextWrapping="Wrap" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </Border>

    <Grid Margin="6,0,6,6">
      <Border x:Name="WebHost" BorderBrush="{StaticResource NotificationBorderBrush}" BorderThickness="0" />
      <ScrollViewer x:Name="Guidance" VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="900" Margin="0">
          <StackPanel>
            <TextBlock Text="{Binding GuidanceTitle}" Style="{StaticResource SectionTitle}" AutomationProperties.AutomationId="BasaltGuidance" />
            <TextBlock Text="{Binding GuidanceText}" Style="{StaticResource Value}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding WebViewProblem}" Style="{StaticResource WarningText}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding WebViewProblem, Converter={StaticResource NotEmptyToVisibility}}" />
            <TextBlock Text="{Binding PathsLine}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <Button Content="경로·포트 설정 열기" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Command="{Binding OpenSettingsCommand}" />
            <Expander Header="Basalt 프로세스와 근거" Margin="0,12,0,0" Visibility="{Binding Processes.Count, Converter={StaticResource NotEmptyToVisibility}}">
              <ItemsControl ItemsSource="{Binding Processes}" Margin="15,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
