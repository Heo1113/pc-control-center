<UserControl x:Class="PcControlCenter.App.Views.SharedSensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding HealthLevel, Converter={StaticResource LevelBrush}}" />
            <TextBlock Text="공통 센서 리더" Style="{StaticResource SectionTitle}" Margin="0" />
          </DockPanel>
          <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}" Margin="0,6,0,8" />
          <ItemsControl ItemsSource="{Binding Health}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Issues}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding StringFormat='⚠ {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="센서를 쓰는 모듈" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding Consumers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="센서 지원 (출처·지원 여부)" Style="{StaticResource SectionTitle}" />
          <DataGrid ItemsSource="{Binding Sources}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                    CanUserAddRows="False" MaxHeight="420">
            <DataGrid.Columns>
              <DataGridTextColumn Header="항목" Binding="{Binding Name}" Width="170" />
              <DataGridTextColumn Header="출처" Binding="{Binding Source}" Width="150" />
              <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="150" />
              <DataGridTextColumn Header="관리자 권한" Binding="{Binding Elevation}" Width="170" />
              <DataGridTextColumn Header="설명" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource WrapCell}" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="장치 정보" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding Device}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
