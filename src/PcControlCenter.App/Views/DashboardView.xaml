<UserControl x:Class="PcControlCenter.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PcControlCenter.App"
             AutomationProperties.AutomationId="IntegratedDashboard">
  <UserControl.Resources>
    <app:CardWidthConverter x:Key="CardWidth" MinWidth="340" HorizontalMargin="12" />
    <Style x:Key="DashCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <!-- Cards share the row (two columns at 1024x768, three at the default size, more on large screens) and keep their own
           height; a lower minimum height leaves less empty space in short cards. -->
      <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}, Converter={StaticResource CardWidth}}" />
      <Setter Property="MinHeight" Value="248" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="OpenButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <!-- Status of each module is already visible in the persistent bottom bar and in its card below.
           Avoid repeating four non-interactive status badges here. -->
      <WrapPanel>
        <!-- Hardware: the shared reader -->
        <Border Style="{StaticResource DashCard}" AutomationProperties.AutomationId="HardwareCard">
          <StackPanel>
            <DockPanel>
              <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding SensorLevel, Converter={StaticResource LevelBrush}}" />
              <TextBlock Text="하드웨어" Style="{StaticResource SectionTitle}" Margin="0" />
            </DockPanel>
            <TextBlock Text="{Binding GpuName}" Style="{StaticResource CardTitle}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding GpuUtil}" Style="{StaticResource BigValue}" ToolTip="GPU 사용률" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="GPU 온도" Style="{StaticResource Label}" />
              <TextBlock Grid.Column="1" Text="{Binding GpuTemp}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="1" Text="GPU 전력 / 제한" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuPower}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="2" Text="VRAM" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GpuVram}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="3" Text="클럭 (코어/메모리)" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GpuClock}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="4" Text="CPU" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CpuUtil}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="5" Text="RAM" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RamUsed}" Style="{StaticResource Value}" />
            </Grid>
            <TextBlock Text="{Binding SensorSource}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding SensorMeasured}" Style="{StaticResource Caption}" />
            <ItemsControl ItemsSource="{Binding SensorIssues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding StringFormat='⚠ {0}'}" Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="하드웨어 화면 열기" Style="{StaticResource OpenButton}" Command="{Binding OpenCommand}" CommandParameter="hardware" />
          </StackPanel>
        </Border>

        <!-- Local AI: Strata (A) -->
        <Border Style="{StaticResource DashCard}" AutomationProperties.AutomationId="LocalAiCard">
          <StackPanel>
            <DockPanel>
              <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding StrataLevel, Converter={StaticResource LevelBrush}}" />
              <TextBlock Text="로컬 AI (Strata)" Style="{StaticResource SectionTitle}" Margin="0" />
            </DockPanel>
            <TextBlock Text="{Binding StrataState}" Style="{StaticResource CardTitle}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding AnswerSpeed}" Style="{StaticResource BigValue}" ToolTip="답변 생성 속도 (엔진 보고)" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="모델" Style="{StaticResource Label}" />
              <TextBlock Grid.Column="1" Text="{Binding StrataModel}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="1" Text="엔진 버전" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StrataEngine}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="2" Text="프롬프트 처리" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PrefillSpeed}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="3" Text="요청" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StrataRequests}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="4" Text="컨텍스트 사용" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StrataContext}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="5" Text="세션 기록" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LocalAiRecording}" Style="{StaticResource Value}" />
            </Grid>
            <TextBlock Text="{Binding StrataNote}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            <Button Content="로컬 AI 화면 열기" Style="{StaticResource OpenButton}" Command="{Binding OpenCommand}" CommandParameter="local-ai" />
          </StackPanel>
        </Border>

        <!-- Power and cost (B) -->
        <Border Style="{StaticResource DashCard}" AutomationProperties.AutomationId="EconomicsCard">
          <StackPanel>
            <TextBlock Text="전력·전력비" Style="{StaticResource SectionTitle}" Margin="0" />
            <TextBlock Text="현재 GPU 보드 전력" Style="{StaticResource CardTitle}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding BoardPower}" Style="{StaticResource BigValue}" ToolTip="{Binding BoardPowerNote}" />
            <TextBlock Text="{Binding BoardPowerSource}" Style="{StaticResource Caption}" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="시간당 전기요금" Style="{StaticResource Label}" />
              <TextBlock Grid.Column="1" Text="{Binding CostPerHour}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="1" Text="적용 요금" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RateText}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="2" Text="오늘 에너지" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TodayEnergy}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="3" Text="오늘 전기요금" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TodayCost}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="4" Text="세션" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EconomicsSessions}" Style="{StaticResource Value}" />
            </Grid>
            <TextBlock Text="{Binding TodayNote}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding EconomicsNote}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            <Button Content="GPU 경제성 화면 열기" Style="{StaticResource OpenButton}" Command="{Binding OpenCommand}" CommandParameter="economics" />
          </StackPanel>
        </Border>

        <!-- Recent Windows errors (C) -->
        <Border Style="{StaticResource DashCard}" AutomationProperties.AutomationId="DiagnosticsCard">
          <StackPanel>
            <DockPanel>
              <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding DiagnosticsLevel, Converter={StaticResource LevelBrush}}" />
              <TextBlock Text="최근 시스템 오류" Style="{StaticResource SectionTitle}" Margin="0" />
            </DockPanel>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="24시간 오류" Style="{StaticResource Label}" />
                <TextBlock Text="{Binding Errors24h}" Style="{StaticResource CardValue}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="24시간 심각" Style="{StaticResource Label}" />
                <TextBlock Text="{Binding Critical24h}" Style="{StaticResource CardValue}" />
              </StackPanel>
              <StackPanel Grid.Row="1">
                <TextBlock Text="7일 하드웨어(WHEA·GPU)" Style="{StaticResource Label}" />
                <TextBlock Text="{Binding HardwareErrors7d}" Style="{StaticResource CardValue}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="7일 비정상 종료·BSOD" Style="{StaticResource Label}" />
                <TextBlock Text="{Binding Crashes7d}" Style="{StaticResource CardValue}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding RecentErrors}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,2">
                    <TextBlock Style="{StaticResource Caption}">
                      <Run Text="{Binding Time, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Severity, Mode=OneWay}" Foreground="{Binding Level, Mode=OneWay, Converter={StaticResource LevelBrush}}" /><Run Text=" · " /><Run Text="{Binding Category, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Value}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="[가상] 테스트 이벤트 - 실제 PC 기록 아님" Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding DiagnosticsNote}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <Button Content="시스템 진단 화면 열기" Style="{StaticResource OpenButton}" Command="{Binding OpenCommand}" CommandParameter="diagnostics" />
          </StackPanel>
        </Border>

        <!-- Operator (E) -->
        <Border Style="{StaticResource DashCard}" AutomationProperties.AutomationId="OperatorCard">
          <StackPanel>
            <DockPanel>
              <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding OperatorLevel, Converter={StaticResource LevelBrush}}" />
              <TextBlock Text="AI Operator" Style="{StaticResource SectionTitle}" Margin="0" />
            </DockPanel>
            <TextBlock Text="{Binding OperatorState}" Style="{StaticResource CardTitle}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Text="작업" Style="{StaticResource Label}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding OperatorTask}" Style="{StaticResource Value}" />
            <TextBlock Text="{Binding OperatorNote}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <Button Content="AI Operator 화면 열기" Style="{StaticResource OpenButton}" Command="{Binding OpenCommand}" CommandParameter="operator" />
          </StackPanel>
        </Border>
      </WrapPanel>
      <DockPanel Margin="6,4">
        <Button DockPanel.Dock="Right" Content="새로 고침" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" />
        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                   Text="{Binding UpdatedAt, StringFormat='갱신 {0} · 하드웨어·Strata는 매초, 전력비는 10초, 오류는 30초마다 다시 읽습니다. 서로 다른 출처의 값은 합치지 않습니다.'}" />
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
