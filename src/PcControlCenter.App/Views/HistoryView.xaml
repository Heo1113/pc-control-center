<UserControl x:Class="PcControlCenter.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LocalAiPerf.App.Controls;assembly=LocalAiPerf.App"
             AutomationProperties.AutomationId="IntegratedHistory">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <WrapPanel VerticalAlignment="Center">
            <TextBlock Text="기간" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" Width="140" Margin="0,0,12,0" />
            <TextBlock Text="끝 날짜(비우면 지금)" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding EndLocal}" Width="150" Margin="0,0,12,0" />
            <Button Content="불러오기" Command="{Binding LoadCommand}" Padding="16,4" AutomationProperties.AutomationId="LoadHistory" />
            <TextBlock Text="{Binding RangeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </WrapPanel>
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource Value}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="출처별 기록 범위와 관측 공백" Style="{StaticResource SectionTitle}" />
          <DataGrid ItemsSource="{Binding Coverage}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="24">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Level, Converter={StaticResource LevelBrush}}" /></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="출처" Binding="{Binding Source}" Width="220" />
              <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="60" />
              <DataGridTextColumn Header="기록" Binding="{Binding Points}" Width="170" />
              <DataGridTextColumn Header="시각 범위" Binding="{Binding Range}" Width="150" />
              <DataGridTextColumn Header="공백" Binding="{Binding Gaps}" Width="140" />
              <DataGridTextColumn Header="참고" Binding="{Binding Note}" Width="*" ElementStyle="{StaticResource WrapCell}" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}"><c:ChartView Model="{Binding PowerChart}" Interactive="True" Height="260" /></Border>
        <Border Style="{StaticResource Card}"><c:ChartView Model="{Binding InferenceChart}" Interactive="True" Height="260" /></Border>
        <Border Style="{StaticResource Card}"><c:ChartView Model="{Binding GpuUtilChart}" Interactive="True" Height="260" /></Border>
        <Border Style="{StaticResource Card}"><c:ChartView Model="{Binding GpuTempChart}" Interactive="True" Height="260" /></Border>
        <Border Style="{StaticResource Card}"><c:ChartView Model="{Binding CpuChart}" Interactive="True" Height="260" /></Border>
      </UniformGrid>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="같은 기간의 사건 (최신순)" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                     Text="Windows 오류(C), 작업 세션(B), 기록 세션·엔진 사건(A), Operator 작업(E)을 시각 순서대로 나열합니다. 나란히 있다고 서로 관련이 있다는 뜻은 아닙니다." />
          <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False"
                    MaxHeight="520">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="24">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Level, Converter={StaticResource LevelBrush}}" /></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="150" />
              <DataGridTextColumn Header="끝" Binding="{Binding End}" Width="150" />
              <DataGridTextColumn Header="출처" Binding="{Binding Source}" Width="190" />
              <DataGridTextColumn Header="종류" Binding="{Binding Kind}" Width="130" />
              <DataGridTextColumn Header="내용" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource WrapCell}" />
              <DataGridTextColumn Header="세부" Binding="{Binding Detail}" Width="200" ElementStyle="{StaticResource TrimCell}" />
              <DataGridCheckBoxColumn Header="테스트 데이터" Binding="{Binding IsTestData, Mode=OneWay}" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
