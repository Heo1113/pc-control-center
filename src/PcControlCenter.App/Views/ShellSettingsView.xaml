<UserControl x:Class="PcControlCenter.App.Views.ShellSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="모듈" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                     Text="꺼 둔 모듈은 시작하지 않으며 데이터도 읽거나 쓰지 않습니다. 변경은 다시 시작하면 적용됩니다." />
          <CheckBox Content="로컬 AI (A · Strata 텔레메트리, 추론 세션)" IsChecked="{Binding LocalAiEnabled}" Margin="0,3" />
          <CheckBox Content="GPU 경제성 (B · 전력 적산, 비용·수익)" IsChecked="{Binding EconomicsEnabled}" Margin="0,3" />
          <CheckBox Content="시스템 진단 (C · Windows 이벤트 로그, WHEA)" IsChecked="{Binding DiagnosticsEnabled}" Margin="0,3" />
          <CheckBox Content="AI Operator (E · UI 자동화 — 별도 권한 제한 프로세스에서 실행)" IsChecked="{Binding OperatorEnabled}" Margin="0,3" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="공통 센서" Style="{StaticResource SectionTitle}" />
          <CheckBox Content="NVIDIA GPU 센서 (NVML) 읽기" IsChecked="{Binding GpuEnabled}" Margin="0,3" />
          <CheckBox Content="CPU·RAM 읽기 (Windows)" IsChecked="{Binding SystemEnabled}" Margin="0,3" />
          <CheckBox Content="프로세스별 GPU 메모리 읽기 (Windows 성능 카운터 · 하드웨어 › GPU 메모리)" IsChecked="{Binding ProcessMemoryEnabled}" Margin="0,3"
                    ToolTip="공통 센서와 별도의 스레드에서 2초(화면을 볼 때)·10초(그 밖) 간격으로 읽습니다. NVML은 열지 않습니다." />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="최대 측정 간격 (ms)" Style="{StaticResource Label}" VerticalAlignment="Center" Width="170" />
            <TextBox Text="{Binding MaxIntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="100" />
          </StackPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                     Text="센서는 실행 중인 모듈이 요청한 가장 짧은 간격으로 한 번만 읽습니다 (500~60000 ms). 각 모듈의 기록 간격은 모듈 설정에서 바꿉니다." />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="화면" Style="{StaticResource SectionTitle}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="글자·화면 배율" Style="{StaticResource Label}" VerticalAlignment="Center" Width="170" />
            <Slider Minimum="0.8" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding FontScale}" Width="240" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FontScale, StringFormat='{}{0:0.0}배'}" Style="{StaticResource Value}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                     Text="Windows 배율(예: 4K 175%)은 자동으로 반영됩니다. 이 값은 그 위에 추가로 곱합니다." />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="AI Operator 프로세스" Style="{StaticResource SectionTitle}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="자동 재시작 횟수" Style="{StaticResource Label}" VerticalAlignment="Center" Width="170" />
            <TextBox Text="{Binding OperatorRestarts, UpdateSourceTrigger=PropertyChanged}" Width="60" />
          </StackPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                     Text="Operator 실행 프로세스가 비정상 종료되면 이 횟수까지 자동으로 다시 시작합니다. 진행 중이던 작업은 다시 실행하지 않습니다." />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="데이터 위치" Style="{StaticResource SectionTitle}" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <TextBlock Text="데이터 폴더" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="1" Text="{Binding DataRoot}" Style="{StaticResource Value}" />
            <TextBlock Grid.Row="1" Text="방식" Style="{StaticResource Label}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataMode}" Style="{StaticResource Value}" />
            <TextBlock Grid.Row="2" Text="공통 설정 파일" Style="{StaticResource Label}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SettingsFile}" Style="{StaticResource Value}" />
          </Grid>
          <DataGrid ItemsSource="{Binding Folders}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                    CanUserAddRows="False" Margin="0,8,0,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="모듈" Binding="{Binding Module}" Width="110" />
              <DataGridTextColumn Header="출처" Binding="{Binding Origin}" Width="230" />
              <DataGridTextColumn Header="데이터베이스" Binding="{Binding Database}" Width="100" />
              <DataGridTextColumn Header="크기" Binding="{Binding Size}" Width="80" />
              <DataGridTextColumn Header="폴더" Binding="{Binding Folder}" Width="*" ElementStyle="{StaticResource TrimCell}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="{Binding DataPolicy}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
          <Button Content="데이터 폴더 열기" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding OpenDataFolderCommand}" />
        </StackPanel>
      </Border>
      <DockPanel Margin="6">
        <Button DockPanel.Dock="Left" Content="저장" Padding="18,4" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveShellSettings" />
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Value}" Margin="12,0,0,0" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
