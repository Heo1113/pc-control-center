<UserControl x:Class="PcControlCenter.App.Views.GpuMemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PcControlCenter.App.Controls"
             xmlns:p="clr-namespace:PcControlCenter.Presentation;assembly=PcControlCenter.Presentation"
             xmlns:charts="clr-namespace:LocalAiPerf.App.Controls;assembly=LocalAiPerf.App"
             AutomationProperties.AutomationId="GpuMemoryPage">
  <UserControl.Resources>
    <c:BindingProxy x:Key="Proxy" Data="{Binding}" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />

    <Style x:Key="Num" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="ToolTip" Value="{x:Null}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MutedCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <!-- Found in the process (model file, Strata's model) only: what a kind usually holds is not data and stays in the detail's note. -->
    <Style x:Key="InsideCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding InsideIsGeneric}" Value="True">
          <Setter Property="Visibility" Value="Hidden" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SecondaryCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="SecondaryNum" TargetType="TextBlock" BasedOn="{StaticResource Num}">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <!-- Detail section headings. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <!-- A small chooser: options side by side as text, the chosen one on a quiet fill (the chart's metric and window). -->
    <Style x:Key="Choices" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="2,0,0,0">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{StaticResource OriginBrush}" />
                      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TextMutedBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AdapterCell" TargetType="TextBlock" BasedOn="{StaticResource MutedCell}">
      <Setter Property="ToolTip" Value="{Binding AdapterFull}" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="MinWidth" Value="32" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource OriginBrush}" />
    </Style>
    <Style x:Key="Stat" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,4,24,4" />
    </Style>

    <!-- A flat button: no chrome until hovered (toolbar links, small icon buttons, legend entries). -->
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TextMutedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter TargetName="Chrome" Property="Background" Value="Transparent" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Legend entry: swatch, label, value; estimates hatched and italic. -->
    <DataTemplate x:Key="Legend" DataType="{x:Type p:LegendItem}">
      <StackPanel Orientation="Horizontal" Margin="0,2,14,0" ToolTip="{Binding ToolTip}">
        <c:Swatch Color="{Binding ColorHex}" IsEstimate="{Binding IsEstimate}" Margin="0,0,5,0" />
        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding Value}" FontSize="12" Margin="5,0,0,0" Foreground="{StaticResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" />
        <TextBlock Text="추정" FontSize="11" FontStyle="Italic" Margin="4,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                   Visibility="{Binding IsEstimate, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>

    <!-- Legend entry of the device strip: a kind group filters the table when clicked; the active one is on a quiet fill. -->
    <DataTemplate x:Key="AdapterLegend" DataType="{x:Type p:LegendItem}">
      <Button Command="{Binding Data.FilterGroupCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding Group}" Margin="0,0,2,0" Padding="5,1,7,1"
              AutomationProperties.Name="{Binding Label}" ToolTip="{Binding ToolTip}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Group}" Value="{x:Null}">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource OriginBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <StackPanel Orientation="Horizontal">
          <c:Swatch Color="{Binding ColorHex}" IsEstimate="{Binding IsEstimate}" Width="8" Height="8" Margin="0,0,6,0" />
          <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
          <TextBlock Text="{Binding Value}" FontSize="12" Margin="5,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="Wrap">
      <WrapPanel />
    </ItemsPanelTemplate>

    <!-- One adapter, every adapter alike: short name · thin bar by kind group with its legend · used / capacity, free, shared · GPU %. -->
    <DataTemplate x:Key="AdapterTemplate" DataType="{x:Type p:AdapterView}">
      <Grid Margin="16,10,16,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Top" Margin="0,0,16,0" ToolTip="{Binding NameToolTip}">
          <TextBlock Text="{Binding ShortName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,0">
          <c:SegmentBar Segments="{Binding DedicatedSegments}" Height="8" ToolTip="전용 메모리(VRAM). 색은 종류 묶음별 합계, 어두운 회색은 어댑터 − 프로세스 합계(계산), 빈 부분은 여유입니다."
                        Visibility="{Binding HasCapacity, Converter={StaticResource BoolToVisibility}}" />
          <ItemsControl ItemsSource="{Binding Legend}" ItemTemplate="{StaticResource AdapterLegend}" ItemsPanel="{StaticResource Wrap}"
                        Focusable="False" Margin="-5,4,0,0" />
          <TextBlock Text="{Binding LegendNote}" Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" Margin="0,2,0,0"
                     Visibility="{Binding LegendNote, Converter={StaticResource NotEmptyToVisibility}}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Top">
          <TextBlock Text="{Binding DedicatedText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"
                     Typography.NumeralAlignment="Tabular" ToolTip="전용 메모리 사용량 / 카드 용량 (Windows 어댑터 카운터, DXGI)" />
          <TextBlock Text="{Binding SecondaryText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,1,0,0"
                     Typography.NumeralAlignment="Tabular" ToolTip="여유 = 카드 용량 − 사용량 (계산). 공유 = GPU가 쓰는 시스템 RAM (LLM의 RAM 오프로딩과 같은 뜻이 아님)" />
          <TextBlock Text="{Binding DeltaText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"
                     ToolTip="기준점 때와 지금의 어댑터 전용 사용량 차이 (측정값의 차)" Visibility="{Binding DeltaText, Converter={StaticResource NotEmptyToVisibility}}" />
        </StackPanel>
        <StackPanel Grid.Column="3" VerticalAlignment="Top" ToolTip="{Binding Engines}"
                    Visibility="{Binding Utilization, Converter={StaticResource NotEmptyToVisibility}}">
          <TextBlock Text="{Binding Utilization}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
          <TextBlock Text="{Binding UtilizationLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- The selected process. -->
    <DataTemplate x:Key="DetailTemplate" DataType="{x:Type p:ProcessDetailView}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" MinWidth="280" MaxWidth="560" />
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <DockPanel LastChildFill="False">
              <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="OnCopyDetail" ToolTip="이 프로세스의 값을 텍스트로 복사 (출처·추정 표시 포함)"
                      AutomationProperties.Name="상세 복사">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" />
                  <TextBlock Text="복사" FontSize="12" Margin="5,0,0,0" />
                </StackPanel>
              </Button>
              <c:Swatch DockPanel.Dock="Left" Color="{Binding KindColor}" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Left" Text="{Binding Pid, StringFormat='PID {0}'}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatLabel}" FontSize="12" />
              <TextBlock DockPanel.Dock="Left" Text="{Binding Kind}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                         Foreground="{StaticResource TextSecondaryBrush}" ToolTip="{Binding KindBasis}" />
              <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" Visibility="{Binding IsStrata, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding StrataEvidence}">
                <TextBlock Text="Strata" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,1,0,2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Subtitle}" />
            <WrapPanel>
              <StackPanel Style="{StaticResource Stat}" ToolTip="GPU 로컬 메모리 (Windows: Local Usage)">
                <TextBlock Text="전용" Style="{StaticResource StatLabel}" />
                <TextBlock Text="{Binding Dedicated}" Style="{StaticResource StatValue}" />
                <TextBlock Text="{Binding DedicatedShare}" Style="{StaticResource StatLabel}" Visibility="{Binding DedicatedShare, Converter={StaticResource NotEmptyToVisibility}}" />
              </StackPanel>
              <StackPanel Style="{StaticResource Stat}" ToolTip="GPU가 쓰는 시스템 RAM (Non Local Usage). LLM이 RAM으로 오프로딩한 양과 같은 뜻이 아닙니다.">
                <TextBlock Text="공유" Style="{StaticResource StatLabel}" />
                <TextBlock Text="{Binding Shared}" Style="{StaticResource StatValue}" />
              </StackPanel>
              <StackPanel Style="{StaticResource Stat}" ToolTip="할당한 GPU 메모리 전체. 지금 VRAM에 있는지와 무관합니다 (Total Committed).">
                <TextBlock Text="커밋" Style="{StaticResource StatLabel}" />
                <TextBlock Text="{Binding Committed}" Style="{StaticResource StatValue}" />
              </StackPanel>
              <StackPanel Style="{StaticResource Stat}">
                <StackPanel.ToolTip>
                  <TextBlock>
                    <Run Text="가장 바쁜 엔진의 사용률 (작업 관리자와 같은 기준). 이 화면을 보는 동안만 읽습니다." />
                    <LineBreak />
                    <Run Text="{Binding Engines, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel.ToolTip>
                <TextBlock Text="GPU" Style="{StaticResource StatLabel}" />
                <TextBlock Text="{Binding Gpu}" Style="{StaticResource StatValue}" />
                <TextBlock Text="{Binding GpuCaption}" Style="{StaticResource StatLabel}" Visibility="{Binding GpuCaption, Converter={StaticResource NotEmptyToVisibility}}" />
              </StackPanel>
            </WrapPanel>

            <!-- The estimated split, or why none is drawn (Strata's engine, a mixture of experts). -->
            <StackPanel Visibility="{Binding BreakdownNote, Converter={StaticResource NotEmptyToVisibility}}">
              <TextBlock Text="{Binding BreakdownTitle}" Style="{StaticResource SectionLabel}" />
              <c:SegmentBar Segments="{Binding Breakdown}" Height="8" Visibility="{Binding Breakdown, Converter={StaticResource NotEmptyToVisibility}}" />
              <ItemsControl ItemsSource="{Binding BreakdownLegend}" ItemTemplate="{StaticResource Legend}" ItemsPanel="{StaticResource Wrap}" Focusable="False" Margin="0,4,0,0"
                            Visibility="{Binding BreakdownLegend, Converter={StaticResource NotEmptyToVisibility}}" />
              <TextBlock Text="{Binding BreakdownNote}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock Text="런타임" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Runtimes}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Models}" Focusable="False" Margin="0,4,0,0"
                          Visibility="{Binding Models, Converter={StaticResource NotEmptyToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type p:ModelRow}">
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="모델" Style="{StaticResource StatLabel}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" ToolTip="{Binding Evidence}">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Num}" Margin="12,2,0,0" VerticalAlignment="Top"
                               Foreground="{StaticResource TextSecondaryBrush}" ToolTip="파일 크기" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding StrataModel, Converter={StaticResource NotEmptyToVisibility}}">
              <TextBlock Text="Strata가 보고한 값" Style="{StaticResource SectionLabel}" ToolTip="{Binding StrataEvidence}" />
              <WrapPanel>
                <StackPanel Style="{StaticResource Stat}">
                  <TextBlock Text="모델" Style="{StaticResource StatLabel}" />
                  <TextBlock Text="{Binding StrataModel}" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Stat}">
                  <TextBlock Text="컨텍스트" Style="{StaticResource StatLabel}" />
                  <TextBlock Text="{Binding StrataWindow}" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Stat}" ToolTip="슬롯의 KV 캐시에 든 토큰 수 (바이트가 아닙니다)">
                  <TextBlock Text="슬롯 토큰" Style="{StaticResource StatLabel}" />
                  <TextBlock Text="{Binding StrataSlots}" Style="{StaticResource StatValue}" />
                </StackPanel>
              </WrapPanel>
            </StackPanel>

            <!-- What the runtimes said about themselves: settings or their last report, never the current use (A1, A2). -->
            <ItemsControl ItemsSource="{Binding Reports}" Focusable="False" Visibility="{Binding Reports, Converter={StaticResource NotEmptyToVisibility}}"
                          AutomationProperties.Name="런타임 보고">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type p:ReportGroup}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                    <ItemsControl ItemsSource="{Binding Facts}" Focusable="False" ItemsPanel="{StaticResource Wrap}"
                                  Visibility="{Binding Facts, Converter={StaticResource NotEmptyToVisibility}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type p:DetailFact}">
                          <StackPanel Style="{StaticResource Stat}" ToolTip="{Binding ToolTip}">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}" FontSize="13" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Column="2">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2" LastChildFill="False">
            <ListBox DockPanel.Dock="Left" Style="{StaticResource Choices}" ItemsSource="{Binding Data.ChartMetricOptions, Source={StaticResource Proxy}}"
                     DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Data.ChartMetric, Source={StaticResource Proxy}}"
                     Margin="-2,0,0,0" ToolTip="그래프에 그릴 값" AutomationProperties.Name="그래프 값" />
            <ListBox DockPanel.Dock="Right" Style="{StaticResource Choices}" ItemsSource="{Binding Data.ChartWindowOptions, Source={StaticResource Proxy}}"
                     DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Data.ChartMinutes, Source={StaticResource Proxy}}"
                     ToolTip="그래프 기간 (최근 30분까지 메모리에 보관)" AutomationProperties.Name="그래프 기간" />
          </DockPanel>
          <charts:ChartView Model="{Binding Chart}" />
        </DockPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="6,0,6,6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="TableRow" Height="3*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="6" />
      <RowDefinition x:Name="DetailRow" Height="2*" MinHeight="220" MaxHeight="900" />
    </Grid.RowDefinitions>

    <!-- Toolbar: find (and the kind filter while one is on) on the left; the reading's status and the three actions on the right.
         Counts and "작은 프로세스 포함" sit under the table, MOCK is in the status text, Strata only while it answers. -->
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Width="260">
        <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                 AutomationProperties.Name="이름, PID, 종류, 런타임 또는 모델로 찾기"
                 ToolTip="이름·PID·종류·런타임·모델로 찾기 (Ctrl+F). Esc로 지우고 Enter나 ↓로 표로 이동" />
        <StackPanel Orientation="Horizontal" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                    Visibility="{Binding Filter, Converter={StaticResource EmptyToVisibility}}">
          <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
          <TextBlock Text="프로세스 찾기" Margin="8,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
        <!-- The theme's own clear button shows while the box has focus; this one keeps the filter visible and clearable after. -->
        <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,4" Command="{Binding ClearFilterCommand}" ToolTip="찾기 지우기 (Esc)"
                AutomationProperties.Name="찾기 지우기">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Filter}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=FilterBox}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9" />
        </Button>
      </Grid>
      <Button Grid.Column="1" Style="{StaticResource FlatButton}" Command="{Binding ClearKindFilterCommand}" Margin="8,0,0,0" Padding="8,3"
              Background="{StaticResource OriginBrush}" ToolTip="종류 필터 해제" AutomationProperties.Name="종류 필터 해제"
              Visibility="{Binding KindFilterText, Converter={StaticResource NotEmptyToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding KindFilterText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9" Margin="7,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
      </Button>
      <TextBlock x:Name="Notice" Grid.Column="2" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Visibility="Collapsed"
                 Foreground="{StaticResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
      <Button Grid.Column="3" Style="{StaticResource FlatButton}" Command="{Binding ShowStrataCommand}" ToolTip="{Binding StrataToolTip}" Margin="0,0,6,0"
              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Strata 프로세스 선택"
              Visibility="{Binding ShowStrataStatus, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <Ellipse Style="{StaticResource StatusDot}" Width="7" Height="7" Fill="{Binding StrataLevel, Converter={StaticResource LevelBrush}}" />
          <TextBlock Text="{Binding StrataText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding StatusToolTip}"
                  AutomationProperties.AutomationId="GpuMemoryStatus">
        <Ellipse Style="{StaticResource StatusDot}" Width="7" Height="7" Fill="{Binding StatusLevel, Converter={StaticResource LevelBrush}}" />
        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Typography.NumeralAlignment="Tabular" />
      </StackPanel>
      <StackPanel Grid.Column="5" Orientation="Horizontal">
        <ToggleButton Style="{StaticResource ToolToggle}" Margin="0" IsChecked="{Binding HasBaseline}"
                      ToolTip="지금 값을 기준점으로 잡고, 이후 프로세스·어댑터별 증감을 표시 (다시 누르면 해제)" AutomationProperties.Name="기준점">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7C1;" Style="{StaticResource Icon}" FontSize="12" />
            <TextBlock Text="기준점" FontSize="12" Margin="6,0,0,0" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding IsPaused}"
                      ToolTip="표와 상세를 지금 값으로 고정 (측정은 계속됨)" AutomationProperties.Name="일시정지">
          <Grid>
            <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </ToggleButton>
        <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding HelpOpen}" ToolTip="사용법과 값의 뜻" AutomationProperties.Name="도움말">
          <TextBlock Text="&#xE897;" Style="{StaticResource Icon}" />
        </ToggleButton>
      </StackPanel>
    </Grid>

    <!-- The GPUs, one line each in one card. -->
    <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6"
            Margin="0,0,0,8" Visibility="{Binding Adapters.Count, Converter={StaticResource NotEmptyToVisibility}}">
      <ItemsControl ItemsSource="{Binding Adapters}" Focusable="False" Margin="0,2">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type p:AdapterSlot}">
            <ContentControl Content="{Binding View}" ContentTemplate="{StaticResource AdapterTemplate}" Focusable="False" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- The baseline: when it was taken, how each adapter changed, what is gone since. -->
    <Border Grid.Row="2" Background="{StaticResource InfoBannerBrush}" BorderBrush="{StaticResource InfoBannerBorderBrush}" BorderThickness="1"
            CornerRadius="6" Padding="12,6" Margin="0,0,0,6" Visibility="{Binding HasBaseline, Converter={StaticResource BoolToVisibility}}"
            AutomationProperties.AutomationId="GpuMemoryBaseline">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding ToggleBaselineCommand}" ToolTip="기준점 해제"
                AutomationProperties.Name="기준점 해제">
          <TextBlock Text="해제" FontSize="12" />
        </Button>
        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="OnCopyBaseline" Margin="0,0,4,0"
                ToolTip="기준점 대비 변화를 텍스트로 복사 (탭 구분)" AutomationProperties.Name="비교 복사">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" />
            <TextBlock Text="복사" FontSize="12" Margin="5,0,0,0" />
          </StackPanel>
        </Button>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding BaselineText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding BaselineText}" />
          <TextBlock Text="{Binding BaselineGone}" Style="{StaticResource Caption}" Visibility="{Binding BaselineGone, Converter={StaticResource NotEmptyToVisibility}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Processes, with the help panel beside them when it is open. -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <DataGrid x:Name="Table" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False"
                CanUserResizeRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="28"
                ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="GpuMemoryProcesses">
        <DataGrid.Resources>
          <!-- The theme draws a selected row with these two brushes (its bright accent fill with dark text). A quiet tint
               keeps the kind colours and the muted cells readable. Scoped to this table. -->
          <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="#26364B" />
          <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush" Color="#F0EFEC" />
        </DataGrid.Resources>
        <DataGrid.Columns>
          <DataGridTemplateColumn SortMemberPath="Name" Width="1.5*" MinWidth="130">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="프로세스" ToolTip="실행 파일 이름. 흐린 이름은 시작 시각을 확인하지 못한 프로세스" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type p:GpuProcessRow}">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,0" ToolTip="{Binding Identity}">
                  <c:Swatch Color="{Binding KindColor}" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Name}" ToolTip="{x:Null}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsUncertain}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Border Style="{StaticResource Chip}" Margin="0" Visibility="{Binding IsStrata, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Strata" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Binding="{Binding Pid}" SortMemberPath="Pid" Width="64" MinWidth="64" ElementStyle="{StaticResource SecondaryNum}">
            <DataGridTextColumn.Header>
              <TextBlock Text="PID" ToolTip="프로세스 ID. 찾기 칸에 PID를 넣으면 그 프로세스만" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTemplateColumn SortMemberPath="KindLabel" Width="80" MinWidth="80">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="종류" ToolTip="불러온 라이브러리·모델 파일·엔진·이름으로 분류한 것 (측정 아님). 근거는 칸의 툴팁" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type p:GpuProcessRow}">
                <TextBlock Text="{Binding KindLabel}" ToolTip="{Binding KindBasis}">
                  <TextBlock.Style>
                    <!-- Text colours only (the swatch beside the name carries the colour); a kind the user gave is in italics. -->
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryCell}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding KindOverridden}" Value="True">
                          <Setter Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn SortMemberPath="Dedicated" Width="104" MinWidth="104">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="전용" ToolTip="GPU 로컬 메모리(VRAM), Windows Local Usage. 카드 용량 대비 비율은 칸의 툴팁" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type p:GpuProcessRow}">
                <TextBlock Text="{Binding DedicatedText}" Style="{StaticResource Num}" ToolTip="{Binding DedicatedShareText}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn SortMemberPath="Delta" Width="104" MinWidth="104">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="변화" ToolTip="기준점 대비 전용 메모리 변화 (측정값의 차). 기울임꼴은 기준점 뒤에 시작했거나 재시작한 프로세스" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type p:GpuProcessRow}">
                <TextBlock Text="{Binding DeltaText}" ToolTip="{Binding DeltaNote}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Num}">
                      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding DeltaNote, Converter={StaticResource NotEmptyToVisibility}}" Value="Visible">
                          <Setter Property="FontStyle" Value="Italic" />
                          <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Binding="{Binding SharedText}" SortMemberPath="Shared" Width="90" MinWidth="90" ElementStyle="{StaticResource SecondaryNum}">
            <DataGridTextColumn.Header>
              <TextBlock Text="공유" ToolTip="GPU가 쓰는 시스템 RAM, Windows Non Local Usage. 오프로딩의 증거는 아님" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding GpuText}" SortMemberPath="Gpu" Width="64" MinWidth="64" ElementStyle="{StaticResource SecondaryNum}">
            <DataGridTextColumn.Header>
              <TextBlock Text="GPU %" ToolTip="가장 바쁜 엔진의 사용률 (작업 관리자와 같은 기준). 화면을 보는 동안만 읽음" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding Runtimes}" SortMemberPath="Runtimes" Width="*" MinWidth="80" ElementStyle="{StaticResource SecondaryCell}">
            <DataGridTextColumn.Header>
              <TextBlock Text="런타임" ToolTip="불러온 DLL 이름으로 감지한 런타임. GPU 작업의 증거는 아님" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding Inside}" SortMemberPath="Inside" Width="1.6*" MinWidth="100" ElementStyle="{StaticResource InsideCell}">
            <DataGridTextColumn.Header>
              <TextBlock Text="내용" ToolTip="이 프로세스에서 확인한 모델 파일이나 Strata 모델" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding Adapter}" SortMemberPath="Adapter" Width="120" MinWidth="120" ElementStyle="{StaticResource AdapterCell}">
            <DataGridTextColumn.Header>
              <TextBlock Text="GPU" ToolTip="이 메모리가 있는 어댑터 (어댑터가 둘 이상일 때)" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,48,16,0"
                 TextAlignment="Center" IsHitTestVisible="False" Visibility="{Binding EmptyText, Converter={StaticResource NotEmptyToVisibility}}" />
      <Border Background="{StaticResource PageBrush}" Visibility="{Binding HasValues, Converter={StaticResource InverseBoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
          <TextBlock Text="{Binding Message}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                     TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding MessageDetail}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

    </Grid>

    <!-- Under the table: how many are listed and the switch for the small ones. -->
    <DockPanel Grid.Row="4" Margin="4,4,4,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" />
      <CheckBox DockPanel.Dock="Right" Content="작은 프로세스 포함" IsChecked="{Binding ShowAll}" FontSize="12" VerticalAlignment="Center" MinHeight="0"
                ToolTip="전용 1 MiB, 공유·커밋 16 MiB 미만인 프로세스도 표시" />
    </DockPanel>

    <GridSplitter x:Name="Splitter" Grid.Row="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="6" Background="Transparent"
                  ResizeDirection="Rows" ToolTip="끌어서 상세 영역 크기 조절 (두 번 누르면 기본 크기)" />

    <!-- The selected process. -->
    <Border Grid.Row="6" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12">
      <Grid>
        <ContentControl Content="{Binding Detail}" ContentTemplate="{StaticResource DetailTemplate}" Focusable="False" />
        <TextBlock Text="{Binding DetailPlaceholder}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   MaxWidth="640" Visibility="{Binding Detail, Converter={StaticResource EmptyToVisibility}}" />
      </Grid>
    </Border>
    <!-- Help: a panel over the table and the detail (it never narrows the table). -->
    <Border Grid.Row="3" Grid.RowSpan="4" Width="320" HorizontalAlignment="Right" Panel.ZIndex="10" Background="{StaticResource CardBrush}"
          BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Visibility="{Binding HelpOpen, Converter={StaticResource BoolToVisibility}}"
          AutomationProperties.AutomationId="GpuMemoryHelp">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="Black" />
    </Border.Effect>
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="14,8,6,2">
          <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding ToggleHelpCommand}" Padding="7,4"
                  ToolTip="닫기" AutomationProperties.Name="도움말 닫기">
            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" />
          </Button>
          <TextBlock Text="사용법" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,0,14,12">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Tips}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type p:DetailFact}">
                  <StackPanel Margin="0,3">
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Caption}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="값의 종류" Style="{StaticResource CardTitle}" Margin="0,12,0,2" />
            <ItemsControl ItemsSource="{Binding ValueKinds}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type p:LegendItem}">
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="72" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                      <c:Swatch Color="{Binding ColorHex}" IsEstimate="{Binding IsEstimate}" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Caption}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="어디서 오는 값인가" Style="{StaticResource CardTitle}" Margin="0,12,0,2" />
            <ItemsControl ItemsSource="{Binding Knowable}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type p:DetailFact}">
                  <StackPanel Margin="0,3">
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Caption}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="다른 도구로 맞춰 보기" Style="{StaticResource CardTitle}" Margin="0,12,0,2" />
            <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
