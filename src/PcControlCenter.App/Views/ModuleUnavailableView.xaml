<UserControl x:Class="PcControlCenter.App.Views.ModuleUnavailableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="820" AutomationProperties.AutomationId="ModuleUnavailable">
    <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}">
        <Run Text="{Binding PageTitle, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding ModuleName, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StateText, Mode=OneWay}" />
      </TextBlock>
      <TextBlock Text="{Binding Message}" Style="{StaticResource Value}" />
      <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}" />
      <TextBlock Text="{Binding Origin, StringFormat='출처: {0}'}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
      <Button Content="모듈 다시 시작" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding RestartCommand}"
              Visibility="{Binding CanRestart, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </Border>
</UserControl>
