<!-- Shell styles on top of project A's palette. Keys the modules' windows (prompt dialogs) expect from their old
     application resources are defined here too, with the same values as in B, C and E. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="InfoBannerBrush" Color="#1f2733" />
  <SolidColorBrush x:Key="InfoBannerBorderBrush" Color="#2f3d52" />
  <SolidColorBrush x:Key="NavSelectedBrush" Color="#24303f" />
  <SolidColorBrush x:Key="SectionBarBrush" Color="#191918" />
  <SolidColorBrush x:Key="NotificationBrush" Color="#3a1d1d" />
  <SolidColorBrush x:Key="NotificationBorderBrush" Color="#5a2a2a" />
  <SolidColorBrush x:Key="OriginBrush" Color="#2a3442" />

  <!-- From project E's theme, for E's approval window (a top-level window outside the module page host). -->
  <SolidColorBrush x:Key="InfoBrush" Color="#5aa2ef" />
  <SolidColorBrush x:Key="DangerButtonBrush" Color="#8f1f1f" />
  <SolidColorBrush x:Key="ApprovalBorderBrush" Color="#fab219" />
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,6,0,2" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="WarningText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Background" Value="{StaticResource DangerButtonBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Padding" Value="10,3" />
  </Style>

  <Style x:Key="TrimCell" TargetType="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
  </Style>

  <Style x:Key="StatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CardValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,2,0,2" />
  </Style>

  <!-- Navigation entry (left menu): a quiet fill and a short accent pill for the open section, no accent block. -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Margin="6,1" Background="Transparent">
            <Border x:Name="Chrome" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter Margin="2,0" />
            </Border>
            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                    Background="{StaticResource AccentBrush}" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#10FFFFFF" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TextMutedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Page tab: text with an accent underline under the open page (no filled block). -->
  <Style x:Key="PageTab" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Margin="0,0,2,0" Background="Transparent">
            <Border x:Name="Chrome" CornerRadius="4" Padding="10,6,10,8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter />
            </Border>
            <Border x:Name="Underline" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="12,0" Background="{StaticResource AccentBrush}" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#10FFFFFF" />
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TextMutedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The status bar's Operator emergency stop: always there, same place and size; outlined while no task runs, filled red
       while one runs (the moment it matters). -->
  <Style x:Key="EmergencyStopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#e66767" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#f0a0a0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Operator.IsTaskRunning}" Value="True">
        <Setter Property="Background" Value="{StaticResource DangerButtonBrush}" />
        <Setter Property="BorderBrush" Value="#e66767" />
        <Setter Property="Foreground" Value="White" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="OriginTag" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource OriginBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
