<Application x:Class="PcControlCenter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcControlCenter.App"
             ThemeMode="Dark"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Project A's validated dark palette is the base for every page; each module's own theme, converters and
             view templates are merged again around that module's pages only (see Hosting/ModulePageHost.cs). -->
        <ResourceDictionary Source="pack://application:,,,/LocalAiPerf.App;component/Themes/Theme.xaml" />
        <ResourceDictionary Source="Themes/Shell.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:LevelBrushConverter x:Key="LevelBrush" />
      <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <local:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
      <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
      <!-- A shell tab: the module's status strip (its old status bar) above the page. Used by Hosting/ModulePageHost. -->
      <DataTemplate x:Key="ShellTabTemplate">
        <DockPanel>
          <ContentPresenter DockPanel.Dock="Top" Content="{Binding Header}" />
          <ContentPresenter Content="{Binding Content}" />
        </DockPanel>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
