       suite's shared hub. No WPF types; tested on Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iron.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Suite.Core.Hardware\Suite.Core.Hardware.csproj" />
    <ProjectReference Include="..\Suite.Core.Storage\Suite.Core.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Iron.Tests" />
  </ItemGroup>
</Project>
