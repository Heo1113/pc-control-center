<!-- IRON control styles: physical switches (1 px press), stone buttons, graphite inputs. Square corners only (radius 0). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:Iron.App.Hosting">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="IronTokens.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <h:StatusBrushConverter x:Key="StatusBrush" />
  <h:StatusInkConverter x:Key="StatusInk" />
  <h:PinBrushConverter x:Key="PinBrush" />
  <h:FluxBrushConverter x:Key="FluxBrush" />
  <h:EqualsConverter x:Key="Equals" />
  <h:VisibleWhenConverter x:Key="VisibleWhen" />
  <h:BoolBrushConverter x:Key="BoolBrush" />
  <h:NotConverter x:Key="Not" />

  <Style x:Key="Iron.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" Stroke="{StaticResource IronAccentOrange}" StrokeThickness="1" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== text ===== -->
  <Style x:Key="Iron.Text.BezelLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IronDisplayFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontLabel}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezelMuted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Iron.Text.BezelTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IronDisplayFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontPanelTitle}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezel}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Iron.Text.BezelValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IronMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontValue}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezelStrong}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Iron.Text.BezelMono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IronMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontSmall}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezelMuted}" />
  </Style>
  <Style x:Key="Iron.Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IronDisplayFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontLabel}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezel}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Iron.Text.ChassisLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IronDisplayFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontTileLabel}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkChassisMuted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Iron.Text.ChassisValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IronMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontTileValue}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkChassis}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Iron.Text.ChassisBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IronDisplayFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontLabel}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkChassis}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Iron.Badge" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ===== surfaces ===== -->
  <Style x:Key="Iron.Bezel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource IronBezelBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource IronBezelBevel}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource Iron.PanelPad}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="Iron.Module" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource IronChassisSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource IronChassisBevel}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource Iron.TilePad}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="Iron.Divider" TargetType="Rectangle">
    <Setter Property="Fill" Value="{StaticResource IronBezelDivider}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ===== title bar switches (physical, 1 px press) ===== -->
  <Style x:Key="Iron.Tab" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Iron.FocusVisual}" />
    <Setter Property="Background" Value="#252825" />
    <Setter Property="BorderBrush" Value="#3E423E" />
    <Setter Property="Foreground" Value="#D6D4CC" />
    <Setter Property="FontFamily" Value="{StaticResource IronDisplayFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontTab}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="{DynamicResource Iron.TabPad}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="0,0,5,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#2E322E" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource IronAccentOrange}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#B85219" />
              <Setter Property="Foreground" Value="#1A1B19" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="1" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- small filter switch on graphite (전체 / 5080 / 5060 Ti) -->
  <Style x:Key="Iron.Filter" TargetType="RadioButton" BasedOn="{StaticResource Iron.Tab}">
    <Setter Property="FontFamily" Value="{StaticResource IronMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontSmall}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Foreground" Value="#C2C4BC" />
  </Style>

  <Style x:Key="Iron.Button.Window" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Iron.FocusVisual}" />
    <Setter Property="Foreground" Value="#9A9D96" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{StaticResource IronMonoFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#4D514B" />
              <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="1" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== buttons ===== -->
  <Style x:Key="Iron.Button.Secondary" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Iron.FocusVisual}" />
    <Setter Property="Background" Value="{StaticResource IronChassisSurfaceHi}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkChassis}" />
    <Setter Property="BorderBrush" Value="{StaticResource IronButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontFamily" Value="{StaticResource IronMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontSmall}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#EFECE4" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="1" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Iron.Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Iron.Button.Secondary}">
    <Setter Property="Background" Value="{StaticResource IronAccentOrange}" />
    <Setter Property="BorderBrush" Value="#A84A16" />
    <Setter Property="Foreground" Value="#1A1B19" />
  </Style>
  <!-- dark small button on graphite -->
  <Style x:Key="Iron.Button.Bezel" TargetType="ButtonBase" BasedOn="{StaticResource Iron.Button.Secondary}">
    <Setter Property="Background" Value="#2A2D2A" />
    <Setter Property="BorderBrush" Value="#4A4E49" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezel}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style x:Key="Iron.Button.Link" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Iron.FocusVisual}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkOrangeOnBezel}" />
    <Setter Property="FontFamily" Value="{StaticResource IronDisplayFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="4,2">
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="#FFB37E" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== switch (settings, mock) ===== -->
  <Style x:Key="Iron.Switch" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Iron.FocusVisual}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezel}" />
    <Setter Property="FontFamily" Value="{StaticResource IronDisplayFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontLabel}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="0,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0" RecognizesAccessKey="False">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
            <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" Background="{StaticResource IronSegmentOff}" BorderBrush="#4A4E49" BorderThickness="1" VerticalAlignment="Center">
              <Border x:Name="Knob" Width="14" Height="14" Background="{StaticResource IronInkBezelMuted}" HorizontalAlignment="Left" Margin="2,0" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource IronAccentOrange}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="#A84A16" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Background" Value="#F4F2EA" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== inputs ===== -->
  <Style x:Key="Iron.TextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource IronInputBg}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="CaretBrush" Value="#FFFFFF" />
    <Setter Property="SelectionBrush" Value="{StaticResource IronAccentOrange}" />
    <Setter Property="BorderBrush" Value="{StaticResource IronInputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="FontFamily" Value="{StaticResource IronMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontLabel}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource IronAccentOrange}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Iron.ComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource IronInkBezel}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#3A3D39" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource IronInkOrangeOnBezel}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Iron.ComboBox" TargetType="ComboBox">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontFamily" Value="{StaticResource IronMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontLabel}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Iron.ComboBoxItem}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Iron.FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome" Background="{StaticResource IronInputBg}" BorderBrush="{StaticResource IronInputBorder}" BorderThickness="1" SnapsToDevicePixels="True">
                    <TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource IronInkBezelMuted}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource IronAccentOrange}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Margin="10,7,30,7" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="False" PopupAnimation="None"
                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Background="{StaticResource IronBezelElevated}" BorderBrush="{StaticResource IronInputBorder}" BorderThickness="1"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" TextElement.Foreground="{StaticResource IronInkBezel}">
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Iron.Expander" TargetType="Expander">
    <Setter Property="Foreground" Value="#B9BCB2" />
    <Setter Property="FontFamily" Value="{StaticResource IronDisplayFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontSmall}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" FocusVisualStyle="{StaticResource Iron.FocusVisual}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <StackPanel Orientation="Horizontal" Background="Transparent">
                    <TextBlock x:Name="Arrow" Text="▶" Margin="0,0,8,0" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource IronInkBezelMuted}" />
                    <ContentPresenter VerticalAlignment="Center" />
                  </StackPanel>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Arrow" Property="Text" Value="▼" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ContentPresenter Content="{TemplateBinding Header}" />
            </ToggleButton>
            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="18,10,0,0" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== slim scroll bars (implicit) ===== -->
  <Style x:Key="Iron.Thumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="#8A887E" Margin="2" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource Iron.Thumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.Thumb>
                    <Thumb Style="{StaticResource Iron.Thumb}" />
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource IronBezelElevated}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezel}" />
    <Setter Property="BorderBrush" Value="{StaticResource IronBezelDivider}" />
    <Setter Property="FontFamily" Value="{StaticResource IronDisplayFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <!-- process table rows (ListBox) -->
  <Style x:Key="Iron.ProcessRowItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezel}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" BorderBrush="{StaticResource IronBezelDivider}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
            <Grid>
              <Rectangle x:Name="Mark" Width="3" HorizontalAlignment="Left" Fill="{StaticResource IronAccentOrange}" Visibility="Collapsed" />
              <ContentPresenter />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource IronRowHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource IronRowSelected}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
