<!-- IRON design tokens (design package tokens/iron.tokens.json, docs/03 §1). Keys follow the "WPF XAML 리소스 키" column.
     The few derived tones (marked) come from the package's prototype CSS (prototype/index.html, .iron-* rules). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- tokens/iron.tokens.json · color -->
  <Color x:Key="IronChassisBgColor">#D8D6CD</Color>
  <Color x:Key="IronChassisSurfaceColor">#CECCC2</Color>
  <Color x:Key="IronChassisBorderColor">#AEACA0</Color>
  <Color x:Key="IronBezelBgColor">#1F211F</Color>
  <Color x:Key="IronBezelElevatedColor">#292C29</Color>
  <Color x:Key="IronBezelDividerColor">#3D413D</Color>
  <Color x:Key="IronAccentOrangeColor">#E06D2B</Color>
  <Color x:Key="IronAccentOrangeHoverColor">#CC5C1E</Color>
  <Color x:Key="IronAccentAmberColor">#D49A35</Color>
  <Color x:Key="IronStatusOnlineColor">#6F8743</Color>
  <Color x:Key="IronStatusWarnColor">#C9851E</Color>
  <Color x:Key="IronStatusErrorColor">#C83E2B</Color>
  <Color x:Key="IronInkChassisColor">#1D1F1D</Color>
  <Color x:Key="IronInkChassisMutedColor">#57574F</Color>
  <Color x:Key="IronInkBezelColor">#ECEAE2</Color>
  <Color x:Key="IronInkBezelMutedColor">#969990</Color>
  <Color x:Key="IronSegmentOffColor">#3A3D39</Color>

  <SolidColorBrush x:Key="IronChassisBg" Color="{StaticResource IronChassisBgColor}" />
  <SolidColorBrush x:Key="IronChassisSurface" Color="{StaticResource IronChassisSurfaceColor}" />
  <SolidColorBrush x:Key="IronChassisBorder" Color="{StaticResource IronChassisBorderColor}" />
  <SolidColorBrush x:Key="IronBezelBg" Color="{StaticResource IronBezelBgColor}" />
  <SolidColorBrush x:Key="IronBezelElevated" Color="{StaticResource IronBezelElevatedColor}" />
  <SolidColorBrush x:Key="IronBezelDivider" Color="{StaticResource IronBezelDividerColor}" />
  <SolidColorBrush x:Key="IronAccentOrange" Color="{StaticResource IronAccentOrangeColor}" />
  <SolidColorBrush x:Key="IronAccentOrangeHover" Color="{StaticResource IronAccentOrangeHoverColor}" />
  <SolidColorBrush x:Key="IronAccentAmber" Color="{StaticResource IronAccentAmberColor}" />
  <SolidColorBrush x:Key="IronStatusOnline" Color="{StaticResource IronStatusOnlineColor}" />
  <SolidColorBrush x:Key="IronStatusWarn" Color="{StaticResource IronStatusWarnColor}" />
  <SolidColorBrush x:Key="IronStatusError" Color="{StaticResource IronStatusErrorColor}" />
  <SolidColorBrush x:Key="IronInkChassis" Color="{StaticResource IronInkChassisColor}" />
  <SolidColorBrush x:Key="IronInkChassisMuted" Color="{StaticResource IronInkChassisMutedColor}" />
  <SolidColorBrush x:Key="IronInkBezel" Color="{StaticResource IronInkBezelColor}" />
  <SolidColorBrush x:Key="IronInkBezelMuted" Color="{StaticResource IronInkBezelMutedColor}" />
  <SolidColorBrush x:Key="IronSegmentOff" Color="{StaticResource IronSegmentOffColor}" />

  <!-- derived (prototype CSS) -->
  <SolidColorBrush x:Key="IronChassisSurfaceHi" Color="#E3E1D8" />
  <SolidColorBrush x:Key="IronButtonBorder" Color="#8E8C80" />
  <SolidColorBrush x:Key="IronBezelEdge" Color="#141514" />
  <SolidColorBrush x:Key="IronTitleEdge" Color="#121312" />
  <SolidColorBrush x:Key="IronInkBezelStrong" Color="#F4F2EA" />
  <SolidColorBrush x:Key="IronInkOrangeOnBezel" Color="#EA985A" />
  <SolidColorBrush x:Key="IronInkHeavyOnBezel" Color="#EE8B4A" />
  <SolidColorBrush x:Key="IronInkErrorOnBezel" Color="#E56B59" />
  <SolidColorBrush x:Key="IronInkErrorOnChassis" Color="#A62B1A" />
  <SolidColorBrush x:Key="IronInkAmberOnBezel" Color="#E5A84B" />
  <SolidColorBrush x:Key="IronInkOkOnBezel" Color="#9AC066" />
  <SolidColorBrush x:Key="IronInkNvml" Color="#A6C8E8" />
  <SolidColorBrush x:Key="IronMeterTrack" Color="#B5B3A7" />
  <SolidColorBrush x:Key="IronLedOff" Color="#666963" />
  <SolidColorBrush x:Key="IronRowSelected" Color="#33281F" />
  <SolidColorBrush x:Key="IronRowHover" Color="#262926" />
  <SolidColorBrush x:Key="IronInputBg" Color="#2A2D2A" />
  <SolidColorBrush x:Key="IronInputBorder" Color="#4C504B" />
  <SolidColorBrush x:Key="IronLcdBg" Color="#0B0C0B" />
  <SolidColorBrush x:Key="IronLcdBorder" Color="#3C403B" />
  <SolidColorBrush x:Key="IronChartBg" Color="#191B19" />
  <SolidColorBrush x:Key="IronChartGrid" Color="#333733" />
  <SolidColorBrush x:Key="IronThresholdLine" Color="#8C6A3A" />

  <!-- Inset graphite bezel: darker top-left edge, lighter bottom-right edge (1 px bevel). -->
  <LinearGradientBrush x:Key="IronBezelBevel" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0D0E0D" Offset="0" />
    <GradientStop Color="#141514" Offset="0.5" />
    <GradientStop Color="#3A3E3A" Offset="1" />
  </LinearGradientBrush>
  <!-- Stone module: light top-left, darker bottom-right. -->
  <LinearGradientBrush x:Key="IronChassisBevel" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E9E7DF" Offset="0" />
    <GradientStop Color="#AEACA0" Offset="0.5" />
    <GradientStop Color="#9C9A8E" Offset="1" />
  </LinearGradientBrush>

  <!-- tokens/iron.tokens.json · typography. WPF cannot select weights of variable fonts, so the static Segoe UI family is
       used for "Segoe UI Variable Display"; Hangul falls back to Malgun Gothic. Numerals are tabular everywhere. -->
  <FontFamily x:Key="IronDisplayFont">Segoe UI, Malgun Gothic</FontFamily>
  <FontFamily x:Key="IronMonoFont">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>

  <sys:Double x:Key="Iron.TitleBarHeight">44</sys:Double>
</ResourceDictionary>
