<!-- Data templates shared by the screens: GPU card, stone module, process rows, pins. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Iron.App.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="IronControls.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ===== slim graphite GPU card (NVML) ===== -->
  <DataTemplate x:Key="Iron.GpuCard">
    <Border Style="{StaticResource Iron.Bezel}" Padding="{DynamicResource Iron.CardPad}">
      <StackPanel>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding IndexText}" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontGpuIndex}"
                       Foreground="{StaticResource IronInkBezelMuted}" VerticalAlignment="Bottom" Margin="0,0,10,3" />
            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Iron.FontGpuName}" FontWeight="Bold" Foreground="#F3F1EA" VerticalAlignment="Bottom" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="온도" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontMetaLabel}" VerticalAlignment="Bottom" Margin="0,0,7,1" />
            <TextBlock Text="{Binding TemperatureText}" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontMetaValue}" FontWeight="Bold"
                       Foreground="{Binding IsHot, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkErrorOnBezel|IronInkBezelStrong}"
                       VerticalAlignment="Bottom" Margin="0,0,18,0" />
            <TextBlock Text="전력" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontMetaLabel}" VerticalAlignment="Bottom" Margin="0,0,7,1" />
            <TextBlock Text="{Binding PowerText}" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontMetaValue}" FontWeight="Bold"
                       Foreground="{Binding PowerMissing, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkErrorOnBezel|IronInkOrangeOnBezel}"
                       VerticalAlignment="Bottom" Margin="0,0,18,0" />
            <TextBlock Text="{Binding ClockText}" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontMetaSmall}"
                       Foreground="{StaticResource IronInkBezelMuted}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
          </StackPanel>
        </Grid>
        <Rectangle Style="{StaticResource Iron.Divider}" Margin="0,0,0,12" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Grid Margin="0,0,0,7">
              <TextBlock Text="GPU 사용률" Style="{StaticResource Iron.Text.BezelLabel}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding LoadText}" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontKpi}" FontWeight="Bold"
                           Foreground="{StaticResource IronInkBezelStrong}" VerticalAlignment="Bottom" />
                <TextBlock Text="%" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontKpiUnit}" Foreground="{StaticResource IronInkBezelMuted}"
                           VerticalAlignment="Bottom" Margin="3,0,0,4" />
              </StackPanel>
            </Grid>
            <c:SegmentBar Ratio="{Binding LoadRatio}" Height="{DynamicResource Iron.SegHeight}" Gap="{DynamicResource Iron.SegGap}" OffBrush="{StaticResource IronSegmentOff}"
                          OnBrush="{Binding IsHot, Converter={StaticResource BoolBrush}, ConverterParameter=IronStatusError|IronAccentOrange}" />
          </StackPanel>
          <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource IronBezelDivider}" Margin="18,0" SnapsToDevicePixels="True" />
          <StackPanel Grid.Column="2">
            <Grid Margin="0,0,0,7">
              <TextBlock Text="VRAM" Style="{StaticResource Iron.Text.BezelLabel}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding VramText}" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontKpi}" FontWeight="Bold"
                           Foreground="{StaticResource IronInkBezelStrong}" VerticalAlignment="Bottom" />
                <TextBlock Text="{Binding VramTotalText}" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontKpiUnit}"
                           Foreground="{StaticResource IronInkBezelMuted}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
              </StackPanel>
            </Grid>
            <c:SegmentBar Ratio="{Binding VramRatio}" Height="{DynamicResource Iron.SegHeight}" Gap="{DynamicResource Iron.SegGap}"
                          OnBrush="{StaticResource IronAccentAmber}" OffBrush="{StaticResource IronSegmentOff}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- ===== stone system module ===== -->
  <DataTemplate x:Key="Iron.Tile">
    <Border Style="{StaticResource Iron.Module}" ToolTip="{Binding ToolTip}">
      <StackPanel>
        <TextBlock Text="{Binding Label}" Style="{StaticResource Iron.Text.ChassisLabel}" Margin="0,0,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Value}" Style="{StaticResource Iron.Text.ChassisValue}" VerticalAlignment="Bottom"
                       Foreground="{Binding IsWarning, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkErrorOnChassis|IronInkChassis}" />
            <TextBlock Text="{Binding Sub}" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontTileSub}" Foreground="{StaticResource IronInkChassisMuted}"
                       VerticalAlignment="Bottom" Margin="9,0,0,3" />
          </StackPanel>
          <c:RatioBar Grid.Column="1" Width="{DynamicResource Iron.MeterWidth}" Height="10" Ratio="{Binding Ratio}" Fill="{StaticResource IronStatusOnline}"
                      Track="{StaticResource IronMeterTrack}" VerticalAlignment="Center" Margin="12,0,0,0"
                      Visibility="{Binding IsWarning, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
        </Grid>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- ===== process rows (WDDM PDH) ===== -->
  <Style x:Key="Iron.Cell" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IronMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontTable}" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezel}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Iron.CellMuted" TargetType="TextBlock" BasedOn="{StaticResource Iron.Cell}">
    <Setter Property="Foreground" Value="{StaticResource IronInkBezelMuted}" />
  </Style>
  <Style x:Key="Iron.HeadCell" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IronDisplayFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontTableHead}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezelMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <DataTemplate x:Key="Iron.ProcessRow">
    <Grid Height="{DynamicResource Iron.RowHeight}" Margin="10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="{DynamicResource Iron.ColGpu}" />
        <ColumnDefinition Width="{DynamicResource Iron.ColDed}" />
        <ColumnDefinition Width="{DynamicResource Iron.ColShr}" />
        <ColumnDefinition Width="{DynamicResource Iron.ColUtil}" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Name}" Style="{StaticResource Iron.Cell}" FontWeight="Bold" ToolTip="{Binding Name}" />
      <TextBlock Grid.Column="1" Text="{Binding AdapterShort}" Style="{StaticResource Iron.CellMuted}" />
      <TextBlock Grid.Column="2" Text="{Binding DedicatedText}" Style="{StaticResource Iron.Cell}" FontWeight="Bold" HorizontalAlignment="Right"
                 Foreground="{Binding IsHeavy, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkHeavyOnBezel|IronInkBezel}" />
      <TextBlock Grid.Column="3" Text="{Binding SharedText}" Style="{StaticResource Iron.CellMuted}" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="4" Text="{Binding UtilizationText}" Style="{StaticResource Iron.Cell}" HorizontalAlignment="Right" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="Iron.ProcessRowFull">
    <Grid Height="{DynamicResource Iron.RowHeight}" Margin="10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="{DynamicResource Iron.ColPid}" />
        <ColumnDefinition Width="{DynamicResource Iron.ColGpu}" />
        <ColumnDefinition Width="{DynamicResource Iron.ColDed}" />
        <ColumnDefinition Width="{DynamicResource Iron.ColShr}" />
        <ColumnDefinition Width="{DynamicResource Iron.ColUtil}" />
        <ColumnDefinition Width="{DynamicResource Iron.ColEngine}" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Name}" Style="{StaticResource Iron.Cell}" FontWeight="Bold" ToolTip="{Binding Name}" />
      <TextBlock Grid.Column="1" Text="{Binding PidText}" Style="{StaticResource Iron.CellMuted}" />
      <TextBlock Grid.Column="2" Text="{Binding AdapterShort}" Style="{StaticResource Iron.CellMuted}" ToolTip="{Binding Adapter}" />
      <TextBlock Grid.Column="3" Text="{Binding DedicatedText}" Style="{StaticResource Iron.Cell}" FontWeight="Bold" HorizontalAlignment="Right"
                 Foreground="{Binding IsHeavy, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkHeavyOnBezel|IronInkBezel}" />
      <TextBlock Grid.Column="4" Text="{Binding SharedText}" Style="{StaticResource Iron.CellMuted}" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="5" Text="{Binding UtilizationText}" Style="{StaticResource Iron.Cell}" HorizontalAlignment="Right" />
      <TextBlock Grid.Column="6" Text="{Binding Engine}" Style="{StaticResource Iron.CellMuted}" Margin="16,0,0,0" />
    </Grid>
  </DataTemplate>

  <!-- ===== WireView pins ===== -->
  <Style x:Key="Iron.PinValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IronMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource Iron.FontPin}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource IronInkBezel}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Level}" Value="Over">
        <Setter Property="Foreground" Value="{StaticResource IronInkErrorOnBezel}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Level}" Value="Inactive">
        <Setter Property="Foreground" Value="{StaticResource IronInkBezelMuted}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
