<!-- 전력 · WireView: WireView Pro II Wired (RTX 5080 SOLID OC, read-only telemetry) next to the NVML board power, the
     RELEASE USB / RESUME TELEMETRY handover, dual GPU power and the hourly cost estimate, and the 60 s trend.
     WireView (12V-2x6 connector only) and NVML (board total) are always labelled with their source and never summed. -->
<UserControl x:Class="Iron.App.Views.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Iron.App.Controls"
             xmlns:v="clr-namespace:Iron.App.Views">
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Border Padding="{DynamicResource Iron.BodyPad}" Height="{Binding ViewportHeight, ElementName=Scroller}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="MinHeight" Value="760" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsNarrow}" Value="True">
              <Setter Property="MinHeight" Value="1320" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- device strip -->
        <Border Background="{StaticResource IronChassisSurface}" BorderBrush="{StaticResource IronChassisBevel}" BorderThickness="1" Padding="16,10" Margin="{DynamicResource Iron.RowGap}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Ellipse Width="10" Height="10" Fill="{Binding WireView.StateKind, Converter={StaticResource StatusBrush}}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding WireView.StateText}" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontSmall}" FontWeight="Bold"
                         Foreground="{StaticResource IronInkChassis}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="WireView Pro II Wired · RTX 5080 SOLID OC" FontSize="{DynamicResource Iron.FontPanelTitle}" FontWeight="Bold" Foreground="{StaticResource IronInkChassis}" />
              <TextBlock Text="12V-2x6 커넥터 실측 · 읽기 전용 조회 · 펌웨어 v05 · USB 상세 정보는 '외부 장치'에" FontSize="{DynamicResource Iron.FontSmall}"
                         Foreground="{StaticResource IronInkChassisMuted}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- connector power | six pins -->
        <c:RatioSplitPanel Grid.Row="1" SideBySide="{Binding PanelsSideBySide}" FirstShare="0.46" Gap="{DynamicResource Iron.ColGap}" SecondMinHeight="300" Margin="{DynamicResource Iron.RowGap}">
          <Border Style="{StaticResource Iron.Bezel}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBlock Text="커넥터 실측 전력" Style="{StaticResource Iron.Text.BezelLabel}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Iron.Badge}" BorderBrush="{StaticResource IronAccentOrange}" Margin="10,0,0,0">
                  <TextBlock Text="출처: WIREVIEW USB" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontSmall}" Foreground="{StaticResource IronInkOrangeOnBezel}" />
                </Border>
              </StackPanel>
              <!-- NVML comparison -->
              <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource IronBezelDivider}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <c:GapGrid Columns="2" ColumnGap="12" RowGap="6">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="RTX 5080 보드 전력" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}" VerticalAlignment="Center" />
                      <Border Style="{StaticResource Iron.Badge}" BorderBrush="#5E7A93" Margin="8,0,0,0" Padding="5,0">
                        <TextBlock Text="NVML" FontFamily="{StaticResource IronMonoFont}" FontSize="11" Foreground="{StaticResource IronInkNvml}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding NvmlBoardText}" Style="{StaticResource Iron.Text.BezelValue}" Foreground="{StaticResource IronInkNvml}" Margin="0,3,0,0" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Δ PCIe 슬롯 + 오차" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}"
                               ToolTip="NVML 보드 전력 − WireView 12V-2x6 실측. WireView는 커넥터로 들어오는 전력만 재므로 PCIe 슬롯 전력(약 15~75 W)과 오차가 차이로 남습니다." />
                    <TextBlock Text="{Binding SlotDeltaText}" Style="{StaticResource Iron.Text.BezelValue}" Margin="0,3,0,0" />
                  </StackPanel>
                </c:GapGrid>
              </Border>
              <StackPanel Margin="0,8,0,10">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding WireView.PowerText}" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontHero}" FontWeight="Bold"
                             Foreground="{StaticResource IronInkBezelStrong}" VerticalAlignment="Bottom" />
                  <TextBlock Text="W" FontFamily="{StaticResource IronMonoFont}" FontSize="{DynamicResource Iron.FontHeroUnit}" Foreground="{StaticResource IronInkOrangeOnBezel}"
                             VerticalAlignment="Bottom" Margin="8,0,0,8" />
                </StackPanel>
                <Grid Margin="0,10,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <c:SegmentBar Ratio="{Binding WireView.RatingRatio}" Segments="24" Height="{DynamicResource Iron.SegHeight}" Gap="{DynamicResource Iron.SegGap}"
                                OnBrush="{StaticResource IronAccentOrange}" OffBrush="{StaticResource IronSegmentOff}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding WireView.RatingText}" Style="{StaticResource Iron.Text.BezelMono}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
                <c:GapGrid Columns="3" ColumnGap="12" RowGap="8">
                  <StackPanel>
                    <TextBlock Text="전압" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}" />
                    <TextBlock Text="{Binding WireView.VoltageText}" Style="{StaticResource Iron.Text.BezelValue}" Margin="0,3,0,0" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="커넥터 IN/OUT" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}" />
                    <TextBlock Text="{Binding WireView.ConnectorText}" Style="{StaticResource Iron.Text.BezelValue}" Margin="0,3,0,0"
                               Foreground="{Binding WireView.PinAlert, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkErrorOnBezel|IronInkBezelStrong}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="팬 듀티 · 케이블 정격" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}" />
                    <TextBlock Text="{Binding WireView.FanText}" Style="{StaticResource Iron.Text.BezelValue}" Margin="0,3,0,0" />
                  </StackPanel>
                </c:GapGrid>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Iron.Bezel}">
            <DockPanel>
              <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="핀 전류 · 12V 6핀 (A)" Style="{StaticResource Iron.Text.BezelLabel}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <TextBlock Text="MAX−MIN Δ " Style="{StaticResource Iron.Text.BezelMono}" />
                  <TextBlock Text="{Binding WireView.DeltaText}" Style="{StaticResource Iron.Text.BezelMono}" FontWeight="Bold"
                             Foreground="{Binding WireView.PinAlert, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkErrorOnBezel|IronInkBezel}" />
                </StackPanel>
              </Grid>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock Text="{Binding WireView.ConfirmText}" Style="{StaticResource Iron.Text.BezelMono}" Foreground="{StaticResource IronInkAmberOnBezel}"
                           Visibility="{Binding WireView.ConfirmText, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding WireView.ThresholdText}" Style="{StaticResource Iron.Text.BezelMono}" />
                <TextBlock Text="무CRC 방어(Stage 2): 응답 길이 · 물리 범위 · 3회 연속 확인 후 경고" Style="{StaticResource Iron.Text.BezelMono}" Margin="0,2,0,0" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding WireView.Pins}" Margin="0,14,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <c:GapGrid Columns="6" ColumnGap="12" RowGap="0" StretchRows="True" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="{Binding Label}" Style="{StaticResource Iron.Text.BezelMono}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                      <c:PinMeter Grid.Row="1" MaxWidth="58" MinHeight="80" Value="{Binding CurrentA}" Maximum="9.5"
                                  Threshold="{Binding DataContext.PinCurrentLimit.Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Fill="{Binding Level, Converter={StaticResource PinBrush}}" Track="#3B3E3A" ThresholdBrush="{StaticResource IronThresholdLine}" ScaleBrush="#5A5E58" />
                      <TextBlock Grid.Row="2" Text="{Binding Text}" Style="{StaticResource Iron.PinValue}" Margin="0,8,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>
        </c:RatioSplitPanel>

        <!-- handover -->
        <Border Grid.Row="2" Background="{StaticResource IronChassisSurface}" BorderBrush="{StaticResource IronChassisBevel}" BorderThickness="1" Padding="16,10" Margin="{DynamicResource Iron.RowGap}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{Binding WireView.HandoverButtonText}" Command="{Binding ToggleUsbCommand}" MinWidth="190" Padding="16,9"
                    IsEnabled="{Binding WireView.IsHandoverBusy, Converter={StaticResource Not}}"
                    ToolTip="RELEASE USB: 읽기를 멈추고 COM 포트를 닫아 공식 앱에 양보 · RESUME: 다시 연결 (Stage 1: 모의, 실제 포트를 열지 않음)">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Iron.Button.Secondary}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WireView.IsReleasedOrBusy}" Value="True">
                      <Setter Property="Background" Value="{StaticResource IronAccentOrange}" />
                      <Setter Property="BorderBrush" Value="#A84A16" />
                      <Setter Property="Foreground" Value="#1A1B19" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="장치 상태 · 포트 양보" FontSize="{DynamicResource Iron.FontSmall}" Foreground="{StaticResource IronInkChassisMuted}" />
              <TextBlock Text="{Binding WireView.HandoverText}" Style="{StaticResource Iron.Text.ChassisBody}" FontWeight="Bold" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- dual GPU power, cost, trend -->
        <c:RatioSplitPanel Grid.Row="3" SideBySide="{Binding PanelsSideBySide}" FirstShare="0.46" Gap="{DynamicResource Iron.ColGap}">
          <c:RatioSplitPanel.Style>
            <Style TargetType="c:RatioSplitPanel">
              <Setter Property="Height" Value="250" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                  <Setter Property="Height" Value="520" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </c:RatioSplitPanel.Style>
          <Border Style="{StaticResource Iron.Bezel}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="듀얼 GPU 전력 · 전기요금 (NVML 보드 합계)" Style="{StaticResource Iron.Text.BezelLabel}" />
              <TextBlock DockPanel.Dock="Bottom" Text="{Binding PowerNote}" Style="{StaticResource Iron.Text.BezelMono}" TextWrapping="Wrap"
                         Foreground="{Binding TotalPowerPartial, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkAmberOnBezel|IronInkBezelMuted}" />
              <c:GapGrid Columns="3" ColumnGap="14" RowGap="8" Margin="0,14,0,10" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="합계 GPU 전력" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}" />
                  <TextBlock Text="{Binding TotalPowerText}" Style="{StaticResource Iron.Text.BezelValue}" FontSize="{DynamicResource Iron.FontTileValue}" Margin="0,4,0,0"
                             Foreground="{Binding TotalPowerPartial, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkErrorOnBezel|IronInkBezelStrong}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="시간당 추정" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}" />
                  <TextBlock Text="{Binding CostPerHourText}" Style="{StaticResource Iron.Text.BezelValue}" FontSize="{DynamicResource Iron.FontTileValue}" Margin="0,4,0,0"
                             Foreground="{Binding TotalPowerPartial, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkErrorOnBezel|IronInkOrangeOnBezel}" />
                </StackPanel>
                <v:NumericField DataContext="{Binding Tariff}" ShowRange="False" />
              </c:GapGrid>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Iron.Bezel}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="전력 추세 · 최근 60초" Style="{StaticResource Iron.Text.BezelLabel}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Rectangle Width="16" Height="2" Fill="{StaticResource IronInkNvml}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Text="5080 NVML" Style="{StaticResource Iron.Text.BezelMono}" Margin="0,0,14,0" />
                  <Rectangle Width="16" Height="2" Fill="{StaticResource IronAccentOrange}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Text="WireView 12V-2x6" Style="{StaticResource Iron.Text.BezelMono}" />
                </StackPanel>
              </Grid>
              <c:TrendChart Series1="{Binding NvmlPowerTrend}" Series2="{Binding WireViewPowerTrend}" Maximum="360" Unit="W"
                            Brush1="{StaticResource IronInkNvml}" Brush2="{StaticResource IronAccentOrange}" GridBrush="{StaticResource IronChartGrid}"
                            LabelBrush="{StaticResource IronInkBezelMuted}" LabelSize="12" TextElement.FontFamily="{StaticResource IronMonoFont}"
                            EmptyText="측정값 없음 — 센서 미연결 또는 초기화 중" />
            </DockPanel>
          </Border>
        </c:RatioSplitPanel>
      </Grid>
    </Border>
  </ScrollViewer>
</UserControl>
