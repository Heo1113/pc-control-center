<!-- Tray popup: only the values that change (GPU temperature and VRAM, WireView power and temperature) and two buttons.
     FLUX PRO appears only when it is disconnected or iUnity conflicts. -->
<UserControl x:Class="Iron.App.Views.TrayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             Typography.NumeralAlignment="Tabular"
             FontFamily="{StaticResource IronDisplayFont}"
             Width="320">
  <UserControl.Resources>
    <ResourceDictionary Source="pack://application:,,,/Iron.App;component/Theme/Metrics.Compact.xaml" />
  </UserControl.Resources>
  <Border Background="{StaticResource IronBezelBg}" BorderBrush="#3D413D" BorderThickness="1">
    <StackPanel>
      <Border Background="#151715" BorderBrush="#353834" BorderThickness="0,0,0,1" Padding="14,9">
        <DockPanel>
          <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Iron.Button.Window}" Content="✕" Width="26" Height="24" ToolTip="닫기" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="IRON" FontWeight="Bold" Foreground="#F3F1EA" FontSize="14" Margin="0,0,12,0" />
            <Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding StatusText}" Foreground="{Binding Status, Converter={StaticResource StatusInk}}" FontSize="12.5" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Margin="14,10,14,10">
        <Grid.Resources>
          <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource IronInkBezelMuted}" />
            <Setter Property="Margin" Value="0,4" />
          </Style>
          <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IronMonoFont}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource IronInkBezelStrong}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,4" />
          </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="RTX 5080" Style="{StaticResource Key}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="{Binding Gpus[0].TemperatureText}" Style="{StaticResource Val}"
                     Foreground="{Binding Gpus[0].IsHot, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkErrorOnBezel|IronInkBezelStrong}" />
          <TextBlock Text=" · " Style="{StaticResource Val}" Foreground="{StaticResource IronInkBezelMuted}" />
          <TextBlock Text="{Binding Gpus[0].VramShortText}" Style="{StaticResource Val}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="RTX 5060 Ti" Style="{StaticResource Key}" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="{Binding Gpus[1].TemperatureText}" Style="{StaticResource Val}"
                     Foreground="{Binding Gpus[1].IsHot, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkErrorOnBezel|IronInkBezelStrong}" />
          <TextBlock Text=" · " Style="{StaticResource Val}" Foreground="{StaticResource IronInkBezelMuted}" />
          <TextBlock Text="{Binding Gpus[1].VramShortText}" Style="{StaticResource Val}" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="WireView 12V-2x6" Style="{StaticResource Key}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TrayWireViewText}" Style="{StaticResource Val}"
                   Foreground="{Binding WireView.PinAlert, Converter={StaticResource BoolBrush}, ConverterParameter=IronInkErrorOnBezel|IronInkBezelStrong}" />
        <TextBlock Grid.Row="3" Text="FLUX PRO" Style="{StaticResource Key}" Visibility="{Binding Flux.TrayWarning, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Flux.TrayWarning}" Style="{StaticResource Val}" Foreground="{StaticResource IronInkAmberOnBezel}"
                   Visibility="{Binding Flux.TrayWarning, Converter={StaticResource VisibleWhen}}" />
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource Iron.Button.Bezel}" Content="{Binding WireView.QuickText}" Command="{Binding ToggleUsbCommand}" BorderThickness="0,1,1,0"
                BorderBrush="#353834" Foreground="{StaticResource IronInkOrangeOnBezel}" Padding="8,10" ToolTip="WireView Pro II COM 포트 해제/재개 (모의)" />
        <Button x:Name="OpenButton" Grid.Column="1" Style="{StaticResource Iron.Button.Bezel}" Content="IRON 열기" BorderThickness="0,1,0,0" BorderBrush="#353834" Padding="8,10" />
      </Grid>
      <TextBlock Text="모의 데이터 (Stage 1)" FontSize="11" Foreground="{StaticResource IronAccentAmber}" HorizontalAlignment="Center" Margin="0,6,0,7" />
    </StackPanel>
  </Border>
</UserControl>
