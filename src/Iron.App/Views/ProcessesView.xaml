<!-- 프로세스: GPU memory per process from the WDDM counters (never mixed with NVML), adapter filter, search, software
     adapter hidden by default, inspector with PID, memory, engine, command line and the last 60 s. -->
<UserControl x:Class="Iron.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Iron.App.Controls">
  <Grid Margin="{DynamicResource Iron.BodyPad}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- toolbar -->
    <Border Background="{StaticResource IronChassisSurface}" BorderBrush="{StaticResource IronChassisBevel}" BorderThickness="1" Padding="12,8" Margin="{DynamicResource Iron.RowGap}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton Style="{StaticResource Iron.Filter}" Content="전체" IsChecked="{Binding Processes.Filter, Converter={StaticResource Equals}, ConverterParameter=전체}" />
          <RadioButton Style="{StaticResource Iron.Filter}" Content="RTX 5080" IsChecked="{Binding Processes.Filter, Converter={StaticResource Equals}, ConverterParameter='RTX 5080'}" />
          <RadioButton Style="{StaticResource Iron.Filter}" Content="RTX 5060 Ti" IsChecked="{Binding Processes.Filter, Converter={StaticResource Equals}, ConverterParameter='RTX 5060 Ti'}" />
        </StackPanel>
        <CheckBox Grid.Column="1" Style="{StaticResource Iron.Switch}" Foreground="{StaticResource IronInkChassis}" Margin="16,0,0,0" Padding="0"
                  VerticalAlignment="Center" IsChecked="{Binding Processes.ShowSoftwareAdapter}"
                  ToolTip="Microsoft Basic Render Driver(소프트웨어 어댑터)는 실제 GPU가 아니어서 기본으로 숨깁니다.">
          <TextBlock Text="소프트웨어 어댑터 표시" TextWrapping="NoWrap" />
        </CheckBox>
        <Grid Grid.Column="3" Width="260" VerticalAlignment="Center">
          <TextBox x:Name="Search" Style="{StaticResource Iron.TextBox}" Text="{Binding Processes.Search, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="프로세스 이름 또는 PID 검색" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                     FontSize="{DynamicResource Iron.FontSmall}" Foreground="{StaticResource IronInkBezelMuted}"
                     Visibility="{Binding Text, ElementName=Search, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
        </Grid>
      </Grid>
    </Border>

    <c:RatioSplitPanel Grid.Row="1" SideBySide="{Binding IsFull}" FirstShare="0.66" Gap="{DynamicResource Iron.ColGap}" SecondMinHeight="{DynamicResource Iron.InspectorMin}">
      <!-- table -->
      <Border Style="{StaticResource Iron.Bezel}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="GPU 메모리 · 프로세스" Style="{StaticResource Iron.Text.BezelTitle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Processes.CountText}" Style="{StaticResource Iron.Text.BezelMono}" VerticalAlignment="Center" />
          </Grid>
          <Border DockPanel.Dock="Top" Background="{StaticResource IronBezelElevated}" Height="30">
            <Grid Margin="10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{DynamicResource Iron.ColPid}" />
                <ColumnDefinition Width="{DynamicResource Iron.ColGpu}" />
                <ColumnDefinition Width="{DynamicResource Iron.ColDed}" />
                <ColumnDefinition Width="{DynamicResource Iron.ColShr}" />
                <ColumnDefinition Width="{DynamicResource Iron.ColUtil}" />
                <ColumnDefinition Width="{DynamicResource Iron.ColEngine}" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="프로세스" Style="{StaticResource Iron.HeadCell}" />
              <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource Iron.HeadCell}" />
              <TextBlock Grid.Column="2" Text="어댑터" Style="{StaticResource Iron.HeadCell}" />
              <TextBlock Grid.Column="3" Text="전용 VRAM" Style="{StaticResource Iron.HeadCell}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="4" Text="공유" Style="{StaticResource Iron.HeadCell}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="5" Text="GPU %" Style="{StaticResource Iron.HeadCell}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="6" Text="엔진" Style="{StaticResource Iron.HeadCell}" Margin="16,0,0,0" />
            </Grid>
          </Border>
          <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Iron.Text.BezelMono}" Margin="0,10,0,0" TextWrapping="Wrap"
                     Text="출처: Windows WDDM 성능 카운터(PDH) · GPU 카드의 NVML VRAM과 합산하지 않음 · Stage 1 모의 데이터" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding Processes.EmptyText}" Style="{StaticResource Iron.Text.BezelMono}" Margin="10,12,0,0"
                     Visibility="{Binding Processes.EmptyText, Converter={StaticResource VisibleWhen}}" />
          <ListBox ItemsSource="{Binding Processes.Rows}" SelectedItem="{Binding Processes.ListSelection, Mode=TwoWay}"
                   ItemTemplate="{StaticResource Iron.ProcessRowFull}" ItemContainerStyle="{StaticResource Iron.ProcessRowItem}"
                   Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Template>
              <ControlTemplate TargetType="ListBox">
                <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </ControlTemplate>
            </ListBox.Template>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- inspector -->
      <Border Style="{StaticResource Iron.Bezel}">
        <Grid>
          <TextBlock Text="왼쪽 표에서 프로세스를 선택하세요." Style="{StaticResource Iron.Text.BezelMono}"
                     Visibility="{Binding Processes.HasSelection, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
          <DockPanel Visibility="{Binding Processes.HasSelection, Converter={StaticResource VisibleWhen}}">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="프로세스 상세 · WDDM PDH" Style="{StaticResource Iron.Text.BezelLabel}" Margin="0,0,0,4" />
              <TextBlock Text="{Binding Processes.Selected.Name}" FontSize="{DynamicResource Iron.FontGpuName}" FontWeight="Bold" Foreground="#F3F1EA"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Processes.Selected.Name}" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <TextBlock Style="{StaticResource Iron.Text.BezelMono}" Text="PID " />
                <TextBlock Style="{StaticResource Iron.Text.BezelMono}" Text="{Binding Processes.Selected.PidText}" />
                <TextBlock Style="{StaticResource Iron.Text.BezelMono}" Text=" · " />
                <TextBlock Style="{StaticResource Iron.Text.BezelMono}" Text="{Binding Processes.Selected.Adapter}" />
                <TextBlock Style="{StaticResource Iron.Text.BezelMono}" Text=" · 엔진 " />
                <TextBlock Style="{StaticResource Iron.Text.BezelMono}" Text="{Binding Processes.Selected.Engine}" Foreground="{StaticResource IronInkBezel}" />
              </StackPanel>
              <c:GapGrid Columns="3" ColumnGap="10" RowGap="10" Margin="0,0,0,12">
                <Border Background="{StaticResource IronBezelElevated}" Padding="10,8">
                  <StackPanel>
                    <TextBlock Text="전용 VRAM" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}" />
                    <TextBlock Text="{Binding Processes.Selected.DedicatedText}" Style="{StaticResource Iron.Text.BezelValue}" Foreground="{StaticResource IronInkOrangeOnBezel}" />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource IronBezelElevated}" Padding="10,8">
                  <StackPanel>
                    <TextBlock Text="공유 메모리" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}" />
                    <TextBlock Text="{Binding Processes.Selected.SharedText}" Style="{StaticResource Iron.Text.BezelValue}" />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource IronBezelElevated}" Padding="10,8">
                  <StackPanel>
                    <TextBlock Text="GPU 사용률" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}" />
                    <TextBlock Text="{Binding Processes.Selected.UtilizationText}" Style="{StaticResource Iron.Text.BezelValue}" />
                  </StackPanel>
                </Border>
              </c:GapGrid>
              <TextBlock Text="커맨드라인" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}" Margin="0,0,0,4" />
              <TextBox Style="{StaticResource Iron.TextBox}" IsReadOnly="True" TextWrapping="Wrap" FontSize="{DynamicResource Iron.FontSmall}"
                       Text="{Binding Processes.Selected.Reading.CommandLine, Mode=OneWay}" Foreground="{StaticResource IronInkBezel}" Margin="0,0,0,12" />
              <TextBlock Text="GPU 사용률 · 최근 60초" Style="{StaticResource Iron.Text.BezelLabel}" FontSize="{DynamicResource Iron.FontSmall}" Margin="0,0,0,6" />
            </StackPanel>
            <c:Sparkline Values="{Binding Processes.SelectedHistory}" Stroke="{StaticResource IronAccentOrange}" Baseline="{StaticResource IronChartGrid}" MinHeight="60" />
          </DockPanel>
        </Grid>
      </Border>
    </c:RatioSplitPanel>
  </Grid>
</UserControl>
