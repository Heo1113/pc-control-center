<Application x:Class="Iron.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- tokens → controls → templates (each merges the one before it), then the default layout metrics. -->
        <ResourceDictionary Source="Theme/IronTemplates.xaml" />
        <ResourceDictionary Source="Theme/Metrics.Full.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
