<Project Sdk="Microsoft.NET.Sdk">
  <!-- IRON Stage 2: real data for the Stage 1 screens. Reuses the existing readers of this repository (NVML GPU and Windows
       CPU/RAM through LocalAiPerf.Telemetry, per-process GPU memory through PcControlCenter.GpuMemory's WDDM counters), the
       HWiNFO REST mapping of stage2-rc3 (compiled in from the same files the PoC uses) and the process identity resolver.
       No new NuGet package, no administrator rights, no driver. Nothing here writes to a device. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iron.Stage2</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\modules\local-ai-performance-center\src\LocalAiPerf.Telemetry\LocalAiPerf.Telemetry.csproj" />
    <ProjectReference Include="..\PcControlCenter.GpuMemory\PcControlCenter.GpuMemory.csproj" />
    <ProjectReference Include="..\Iron.ProcessIdentity\Iron.ProcessIdentity.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- One source of truth for the HWiNFO mapping: the RC3 model (same code the PoC and its fixtures check). -->
    <Compile Include="..\..\stage2-rc3\poc\src\IronModel.cs" Link="HwInfo\Rc3\IronModel.cs" />
    <Compile Include="..\..\stage2-rc3\poc\src\Js.cs" Link="HwInfo\Rc3\Js.cs" />
    <!-- embedded (the IRON program is published as one file) -->
    <EmbeddedResource Include="..\..\stage2-rc3\config\mapping_rules.json" LogicalName="Iron.Stage2.hwinfo.mapping_rules.json" WithCulture="false" />
    <EmbeddedResource Include="..\..\stage2-rc3\config\iron_stage1_thresholds.json" LogicalName="Iron.Stage2.hwinfo.iron_stage1_thresholds.json" WithCulture="false" />
    <EmbeddedResource Include="..\..\stage2-rc3\config\gates.json" LogicalName="Iron.Stage2.hwinfo.gates.json" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Iron.App.Tests" />
    <InternalsVisibleTo Include="Iron.Stage2.Tests" />
  </ItemGroup>
</Project>
